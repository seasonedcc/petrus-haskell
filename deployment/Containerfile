# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# The Haskell image of Hamsterdan, keeping the reference image's runtime
# contract (upstream/hamsterdan/deployment/Containerfile): the same pinned
# base images, Pi runtime, user and group, state directory, environment,
# labels, port, entrypoint and command. Where the reference copies a Python
# virtual environment, this image copies the hamsterdan-host,
# hamsterdan-operator and hamsterdan-export binaries and, at the reference's
# interpreter path, a shim (deployment/python-shim) that runs them for the
# module invocations the deployment tooling makes. See
# packages/hamsterdan-operator/PARITY.md, "Container runtime contract".

FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS pi
WORKDIR /opt/hamsterdan/pi
COPY deployment/pi/package.json deployment/pi/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# The local packages' .cabal files alone. The build stage copies them before
# the sources, so its dependency layer (every Hackage package of the frozen
# plan) is reused from the build cache until a .cabal file, cabal.project or
# the freeze changes.
FROM python:3.14.7-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52 AS cabal-files
COPY packages /opt/hamsterdan/src/packages
RUN find /opt/hamsterdan/src/packages -type f ! -name '*.cabal' -delete \
    && find /opt/hamsterdan/src/packages -mindepth 1 -depth -type d -empty -delete

FROM python:3.14.7-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52 AS build
ARG GHC_VERSION=9.10.3
ARG CABAL_VERSION=3.16.1.0
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
       build-essential ca-certificates curl git libffi-dev libgmp-dev libncurses-dev libpq-dev \
       libsqlite3-dev libzmq3-dev pkg-config xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
ENV GHCUP_INSTALL_BASE_PREFIX=/opt/toolchain \
    PATH="/opt/toolchain/.ghcup/bin:${PATH}"
RUN mkdir -p /opt/toolchain/.ghcup/bin \
    && curl --fail --silent --show-error --location --proto '=https' \
       --output /opt/toolchain/.ghcup/bin/ghcup "https://downloads.haskell.org/~ghcup/$(uname -m)-linux-ghcup" \
    && chmod 0755 /opt/toolchain/.ghcup/bin/ghcup \
    && ghcup install ghc "${GHC_VERSION}" --set \
    && ghcup install cabal "${CABAL_VERSION}" --set
WORKDIR /opt/hamsterdan/src
COPY cabal.project LICENSE NOTICE ./
COPY cabal.project.freeze ./cabal.project.freeze
COPY --from=cabal-files /opt/hamsterdan/src/packages ./packages
# Plan the three executables from the .cabal files, then build every Hackage
# library of that plan into the store through a project of one empty
# package that depends on them, with the same freeze and package options.
RUN cabal update \
    && cabal build --dry-run --disable-tests --disable-benchmarks \
       exe:hamsterdan-host exe:hamsterdan-operator exe:hamsterdan-export \
    && mkdir -p /opt/hamsterdan/dependencies \
    && python3 -c 'import json; plan = json.load(open("dist-newstyle/cache/plan.json")); names = sorted({unit["pkg-name"] for unit in plan["install-plan"] if unit.get("style") == "global" and unit.get("component-name", "lib") == "lib"}); print("cabal-version: 3.0\nname: hamsterdan-dependencies\nversion: 0\nbuild-type: Simple\n\nlibrary\n  default-language: Haskell2010\n  build-depends: " + ", ".join(names))' \
       > /opt/hamsterdan/dependencies/hamsterdan-dependencies.cabal \
    && cp cabal.project.freeze /opt/hamsterdan/dependencies/cabal.project.freeze \
    && printf 'packages: .\n\npackage *\n  ghc-options: -fhide-source-paths\n' > /opt/hamsterdan/dependencies/cabal.project \
    && cabal build --project-dir=/opt/hamsterdan/dependencies --only-dependencies all
COPY packages ./packages
RUN cabal build --disable-tests --disable-benchmarks \
       exe:hamsterdan-host exe:hamsterdan-operator exe:hamsterdan-export \
    && mkdir -p /opt/hamsterdan/bin \
    && for executable in hamsterdan-host hamsterdan-operator hamsterdan-export; do \
         install --mode 0755 "$(cabal list-bin --disable-tests --disable-benchmarks "exe:${executable}")" /opt/hamsterdan/bin/; \
       done \
    && strip /opt/hamsterdan/bin/*

FROM python:3.14.7-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52 AS runtime
ARG SOURCE_REVISION
ARG SOURCE_VERSION
ARG SOURCE_CREATED
LABEL org.opencontainers.image.created="${SOURCE_CREATED}" \
      org.opencontainers.image.description="GitHub-native PR-readiness application powered by Petrus" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/henriquebastos/hamsterdan" \
      org.opencontainers.image.title="Hamsterdan" \
      org.opencontainers.image.version="${SOURCE_VERSION}"
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends ca-certificates git libffi8 libgmp10 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 hamsterdan \
    && useradd --uid 10001 --gid hamsterdan --home-dir /nonexistent --shell /usr/sbin/nologin hamsterdan \
    && install --directory --owner hamsterdan --group hamsterdan --mode 0700 /var/lib/hamsterdan
WORKDIR /opt/hamsterdan
COPY --from=build --chown=hamsterdan:hamsterdan /opt/hamsterdan/bin ./bin
COPY --chown=hamsterdan:hamsterdan --chmod=0755 deployment/python-shim ./.venv/bin/python
COPY --from=pi --chown=hamsterdan:hamsterdan /opt/hamsterdan/pi ./pi
COPY --chmod=0755 scripts/with-runtime-secrets /opt/hamsterdan/with-runtime-secrets
ENV PATH="/opt/hamsterdan/.venv/bin:${PATH}" \
    OP_CONFIG_DIR="/tmp/hamsterdan-op" \
    HAMSTERDAN_PI_CLI_PATH="/opt/hamsterdan/pi/node_modules/@earendil-works/pi-coding-agent/dist/cli.js" \
    HAMSTERDAN_PI_NODE_PATH="/opt/hamsterdan/pi/node_modules/node/bin/node" \
    HAMSTERDAN_PI_PACKAGE_ROOT="/opt/hamsterdan/pi/node_modules/@earendil-works/pi-coding-agent" \
    HAMSTERDAN_STATE_PATH="/var/lib/hamsterdan"
USER hamsterdan
EXPOSE 8000
ENTRYPOINT ["/opt/hamsterdan/.venv/bin/python", "-m", "hamsterdan.host"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
