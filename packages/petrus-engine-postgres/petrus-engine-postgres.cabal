cabal-version:      3.4
name:               petrus-engine-postgres
version:            0.1.0.0
synopsis:           The PostgreSQL Engine provider for the Petrus port
description:
  A port of @petrus.engine.postgres@ and @petrus.engine._postgres@: Engine
  construction doors over a join-mode PostgreSQL connection, composing the
  authority fence (taken before any History is read), the PostgreSQL
  History Store, and the Engine's joined-transaction fate — commit at the
  Engine's commit points, rollback and poisoning on failure, unlock then
  rollback on release, and the connection closed on every failed
  construction. "Petrus.Engine.Postgres.Joined" is the composition the
  Absurd provider reuses.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Workflow
build-type:         Simple
extra-doc-files:    NOTICE
                    PARITY.md
                    DIVERGENCES.md
                    bench/RESULTS.md

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Engine.Postgres
                    Petrus.Engine.Postgres.Joined
  build-depends:    base >=4.18 && <5
                  , petrus-engine
                  , petrus-history-postgres
                  , petrus-impetus
                  , petrus-motus
                  , petrus-postgres
                  , text >=2.0
  ghc-options:      -O2

test-suite petrus-engine-postgres-test
  import:           warnings
  type:             exitcode-stdio-1.0
  -- The kernel's and the Engine's shared test fixtures are compiled in from
  -- their test trees rather than copied.
  hs-source-dirs:   test ../petrus-impetus/test ../petrus-engine/test ../petrus-history-postgres/test
  main-is:          Main.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.HistoryStore.Postgres.Support
                    Petrus.Engine.PostgresSpec
                    Petrus.Engine.Postgres.InteropSpec
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , hspec >=2.10
                  , petrus-activity
                  , petrus-engine
                  , petrus-engine-postgres
                  , petrus-history-postgres
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-postgres
                  , petrus-telemetry
                  , petrus-test-support
                  , process >=1.6
                  , text
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark petrus-engine-postgres-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench ../petrus-impetus/test
  main-is:          Main.hs
  other-modules:    Petrus.Impetus.TestSupport
  build-depends:    base
                  , bytestring
                  , containers
                  , hspec >=2.10
                  , petrus-engine
                  , petrus-engine-postgres
                  , petrus-history-postgres
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-postgres
                  , text
  ghc-options:      -threaded -O2 -rtsopts "-with-rtsopts=-A32m"
