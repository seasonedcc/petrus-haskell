cabal-version:      3.4
name:               petrus-test-support
version:            0.1.0.0
synopsis:           Internal test helpers for the Petrus port
description:
  Shared test infrastructure for the Petrus packages: locating the pinned
  upstream checkout and its fixtures, running Python reference snippets in the
  upstream virtual environment for differential tests, live round trips of
  Haskell-produced Net definitions, Net documents and History records through
  the reference's own parsers and serializers, and a PostgreSQL
  resource that creates and drops a scratch database per test run (configured
  by the @PETRUS_TEST_POSTGRES@ connection string). Not meant for use outside
  this repository's test suites.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned (see NOTICE)
author:             Seasoned
maintainer:         daniel@seasoned.cc
category:           Testing
build-type:         Simple
extra-doc-files:    NOTICE

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.TestSupport
                    Petrus.TestSupport.BenchTwin
                    Petrus.TestSupport.Boundary
                    Petrus.TestSupport.Postgres
                    Petrus.TestSupport.Python
                    Petrus.TestSupport.Reference
                    Petrus.TestSupport.Repo
                    Petrus.TestSupport.Valid
  build-depends:    base >=4.18 && <5
                  , base64-bytestring >=1.2
                  , bytestring >=0.11
                  , directory >=1.3.8
                  , filepath >=1.4
                  , hspec >=2.10
                  , petrus-json
                  , postgresql-libpq >=0.10
                  , process >=1.6
                  , random >=1.2
                  , tasty >=1.4
                  , temporary >=1.3
                  , text >=2.0
                  , typed-process >=0.2.11
                  , unix >=2.8

test-suite petrus-test-support-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:    base
                  , bytestring
                  , directory
                  , filepath
                  , hspec
                  , petrus-json
                  , petrus-test-support
                  , postgresql-libpq
                  , text
