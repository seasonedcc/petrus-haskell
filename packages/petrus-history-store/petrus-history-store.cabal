cabal-version:      3.4
name:               petrus-history-store
version:            0.1.0.0
synopsis:           Durable History Store backends for the Petrus Impetus kernel
description:
  Durable spellings of the one event History behind the kernel's
  HistoryStore contract (a port of @petrus.impetus.history_store@'s durable
  backends): the JSONL store, byte-compatible with the reference's
  @JsonlHistoryStore@, and the SQLite store with the same DDL text, rows and
  payload spelling as the reference's @SqliteHistoryStore@, plus the SQLite
  writer fence. Haskell and Python processes read and append to each other's
  files and resume each other's Instances.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned; portions 2026 Henrique Bastos (see NOTICE)
author:             Seasoned
maintainer:         daniel@seasoned.cc
category:           Database
build-type:         Simple
extra-doc-files:    NOTICE

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.HistoryStore
                    Petrus.HistoryStore.Internal
                    Petrus.HistoryStore.Jsonl
                    Petrus.HistoryStore.Sqlite
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , directory >=1.3
                  , filepath >=1.4
                  , petrus-impetus
                  , petrus-json
                  , petrus-posix
                  , petrus-sqlite
                  , petrus-telemetry
                  , text >=2.0
                  , unix >=2.8
  ghc-options:      -O2

test-suite petrus-history-store-test
  import:           warnings
  type:             exitcode-stdio-1.0
  -- The kernel's shared test fixtures (every_record_category and friends)
  -- are compiled in from its test tree rather than copied.
  hs-source-dirs:   test ../petrus-impetus/test
  main-is:          Main.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Impetus.HistorySupport
                    Petrus.Impetus.HistoryStoreContract
                    Petrus.HistoryStore.Support
                    Petrus.HistoryStore.JsonlSpec
                    Petrus.HistoryStore.BackendContractSpec
                    Petrus.HistoryStore.InteropSpec
                    Petrus.HistoryStore.SqliteSupport
                    Petrus.HistoryStore.SqliteSpec
                    Petrus.HistoryStore.SqliteInteropSpec
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , hspec >=2.10
                  , petrus-activity
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-posix
                  , petrus-sqlite
                  , petrus-telemetry
                  , petrus-test-support
                  , process >=1.6
                  , text
  ghc-options:      -threaded -rtsopts

benchmark petrus-history-store-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-test-support
                  , tasty-bench >=0.3.2
                  , tasty
                  , text
  -- The RTS defaults (-A4m), as the executables that use these stores run
  -- (hamsterdan-host sets no -A) and every bench here runs: a
  -- 32 MB allocation area made the allocation-bound rows slower (the
  -- in-memory append 306 against 246 µs, loads and resumes 10-15%;
  -- bench/RESULTS.md, "Current figures").
  ghc-options:      -O2 -rtsopts
