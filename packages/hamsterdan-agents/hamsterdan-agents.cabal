cabal-version:      3.4
name:               hamsterdan-agents
version:            0.1.0.0
synopsis:           Hamsterdan's Pi agent adapter and its host composition
description:
  The Hamsterdan agent adapter (@src/hamsterdan/agents@): the canonical Pi
  prompt envelope, strict result validation, and the Pi native runner over
  Petrus's Pi A2 Local host; and its host composition
  (@src/hamsterdan/host/{agenticus,pi_a2,pi_workspace}.py@): catalog
  resolution, the durable agent route store, sealed connection keys, the
  installation binding, and the Git workspace provider. Every on-disk
  format is the reference's, byte for byte, so the Haskell and Python hosts
  can resume each other's agent state.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned; portions 2026 Henrique Bastos (see NOTICE)
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Control
build-type:         Simple
extra-doc-files:    NOTICE
                    README.md
                    PARITY.md
                    DIVERGENCES.md

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors
                      MultiWayIf

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Hamsterdan.Agents.Validate
                    Hamsterdan.Agents.Url
                    Hamsterdan.Agents.Pi
                    Hamsterdan.Agents.Pi.Doubles
                    Hamsterdan.Host.Binding
                    Hamsterdan.Host.Agenticus
                    Hamsterdan.Host.PiA2
                    Hamsterdan.Host.PiWorkspace
                    Hamsterdan.Host.AgentRuntime
                    Hamsterdan.Host.Scripted
                    Hamsterdan.Host.Random
  build-depends:    base >=4.18 && <5
                  , base16-bytestring >=1.0
                  , bytestring >=0.11
                  , containers >=0.6
                  , crypton >=1.0
                  , cryptohash-sha256 >=0.11
                  , directory >=1.3
                  , filepath >=1.4
                  , hamsterdan-contracts
                  , petrus-agenticus-core
                  , petrus-agenticus-runtime
                  , petrus-execution
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-posix
                  , process >=1.6
                  , ram >=0.20
                  , text >=2.0
                  , unix >=2.8
  ghc-options:      -O2

test-suite hamsterdan-agents-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ProtocolSpec
                    PiSpec
                    PiDoubles
                    AgenticusSpec
                    PiA2Spec
                    PiA2FactorySpec
                    PiWorkspaceSpec
                    InteropSpec
  build-depends:    base
                  , bytestring
                  , ram
                  , unix
                  , containers
                  , cryptohash-sha256
                  , base16-bytestring
                  , hamsterdan-agents
                  , directory
                  , filepath
                  , hamsterdan-contracts
                  , hspec >=2.10
                  , petrus-agenticus-core
                  , petrus-agenticus-runtime
                  , petrus-execution
                  , petrus-json
                  , petrus-execution
                  , petrus-motus
                  , petrus-test-support
                  , process
                  , temporary >=1.3
                  , text
  ghc-options:      -threaded -rtsopts

benchmark hamsterdan-agents-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  build-depends:    base
                  , base64-bytestring
                  , bytestring
                  , directory
                  , filepath
                  , hamsterdan-agents
                  , hamsterdan-contracts
                  , petrus-agenticus-core
                  , petrus-agenticus-runtime
                  , petrus-json
                  , ram
                  , tasty
                  , tasty-bench >=0.3.2
                  , text
  ghc-options:      -O2 -threaded -rtsopts
