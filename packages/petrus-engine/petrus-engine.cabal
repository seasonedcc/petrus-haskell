cabal-version:      3.4
name:               petrus-engine
version:            0.1.0.0
synopsis:           The Petrus Engine: one live composition around one durable Instance
description:
  A port of @petrus.engine@: the Engine and its asynchronous coordinator —
  driving policies, clocks, sensors, read doors, crash recovery on the
  first advance, joined-transaction commit points, and poisoning on
  writing-door failures. Durable providers compose through
  "Petrus.Engine.Provider"; protocol views build on
  "Petrus.Engine.Observation".
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Workflow
build-type:         Simple

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Engine
                    Petrus.Engine.Coordinator
                    Petrus.Engine.Internal
                    Petrus.Engine.Observation
                    Petrus.Engine.Provider
                    Petrus.Engine.Vocabulary
  build-depends:    base >=4.18 && <5
                  , containers >=0.6
                  , deepseq >=1.4
                  , petrus-activity
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-telemetry
                  , text >=2.0
  ghc-options:      -O2

common engine-tests
  import:           warnings
  -- The kernel's shared test fixtures are compiled in from its test tree.
  hs-source-dirs:   test ../petrus-impetus/test
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , hspec >=2.10
                  , petrus-activity
                  , petrus-engine
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-telemetry
                  , process >=1.6
                  , text
  ghc-options:      -threaded -rtsopts

-- Porting stanza: test_engine.py (all 28 tests).
test-suite petrus-engine-engine
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          EngineMain.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.Engine.EngineSpec

-- Porting stanza: test_coordinator.py (42 tests, minus the 7 TestInMemoryDispatch/TestInlineDispatch ones already in petrus-motus).
test-suite petrus-engine-coordinator
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          CoordinatorMain.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.Engine.CoordinatorSpec

-- Porting stanza: test_execution.py outside TestIdentifiedDeliveryPhases.
test-suite petrus-engine-execution
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          ExecutionMain.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.Engine.ExecutionSpec

-- Porting stanza: test_execution.py TestIdentifiedDeliveryPhases, source lines 392-1485.
test-suite petrus-engine-phases-a
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          DeliveryPhasesAMain.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.Engine.DeliveryPhasesASpec

-- Porting stanza: test_execution.py TestIdentifiedDeliveryPhases, source lines 1486-2769.
test-suite petrus-engine-phases-b
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          DeliveryPhasesBMain.hs
  other-modules:    Petrus.Impetus.TestSupport
                    Petrus.Engine.TestSupport
                    Petrus.Engine.DeliveryPhasesBSpec

-- Porting stanza: test_execution.py TestIdentifiedDeliveryPhases, source lines 2770-3580.
test-suite petrus-engine-phases-c
  import:           engine-tests
  type:             exitcode-stdio-1.0
  main-is:          DeliveryPhasesCMain.hs
