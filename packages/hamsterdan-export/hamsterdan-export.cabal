cabal-version:      3.4
name:               hamsterdan-export
version:            0.1.0.0
synopsis:           Hamsterdan's offline evidence exporter
description:
  @python -m hamsterdan.host.export@ (@src/hamsterdan/host/export.py@):
  export one pull request's durable Hamsterdan state as a self-contained
  offline evidence package. Given the same state directory, the package,
  the report and the command line's output are the reference's, byte for
  byte.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned; portions 2026 Henrique Bastos (see NOTICE)
author:             Seasoned
maintainer:         daniel@seasoned.cc
category:           Control
build-type:         Simple
extra-doc-files:    NOTICE
                    README.md
                    PARITY.md
                    DIVERGENCES.md

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Hamsterdan.Export
                    Hamsterdan.Export.Files
                    Hamsterdan.Export.Parallel
  build-depends:    base >=4.18 && <5
                  , async >=2.2
                  , bytestring >=0.11
                  , containers >=0.6
                  , deepseq >=1.4
                  , direct-sqlite >=2.3.27
                  , directory >=1.3
                  , petrus-argparse
                  , hamsterdan-contracts
                  , hamsterdan-readiness
                  , petrus-engine-file
                  , petrus-json
                  , petrus-posix
                  , petrus-sqlite
                  , text >=2.0
                  , unix >=2.8
  ghc-options:      -O2

executable hamsterdan-export
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
                  , hamsterdan-export
                  , petrus-argparse
  -- Up to four capabilities for the parallel parse and render
  -- (DIVERGENCES.md, internal); otherwise the RTS defaults (a 4 MB
  -- allocation area).
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-maxN4"

test-suite hamsterdan-export-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ExportSpec
                    Fixtures
                    DifferentialSpec
  build-tool-depends: hamsterdan-export:hamsterdan-export
  build-depends:    base
                  , base16-bytestring
                  , bytestring
                  , containers
                  , cryptohash-sha256
                  , direct-sqlite
                  , directory
                  , filepath
                  , hamsterdan-export
                  , hspec >=2.10
                  , petrus-json
                  , petrus-test-support
                  , process
                  , temporary >=1.3
                  , text
                  , typed-process
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark hamsterdan-export-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench test
  main-is:          Main.hs
  other-modules:    Fixtures
  build-tool-depends: hamsterdan-export:hamsterdan-export
  build-depends:    base
                  , base16-bytestring
                  , bytestring
                  , containers
                  , cryptohash-sha256
                  , direct-sqlite
                  , directory
                  , filepath
                  , hamsterdan-export
                  , petrus-json
                  , petrus-test-support
                  , process
                  , temporary >=1.3
                  , text
                  , typed-process
                  , unix
  -- The binary's RTS options.
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-maxN4"
