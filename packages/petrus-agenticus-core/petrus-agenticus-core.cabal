cabal-version:      3.4
name:               petrus-agenticus-core
version:            0.1.0.0
synopsis:           The pure and SQLite-backed core layers of Petrus Agenticus
description:
  A Haskell port of the kernel-free layers of @petrus.agenticus@: the host
  Catalog and its compatibility resolution, Thread/Episode/Turn lifecycle
  values and opaque Continuations, Agent Program descriptors and seams,
  provider-neutral external Effects, the capability-scoped Hands contract,
  grants, gateway and ES-049 conformance policy, and Agent Connection
  custody (key boundary, private-file materialization, SQLite CAS storage).
  Every wire and storage format is byte-identical to the reference.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Control
build-type:         Simple
extra-doc-files:    PARITY.md
                    DIVERGENCES.md
                    parity/*.md
                    divergences/*.md
                    bench/*.md
extra-source-files: test/conformance/*.json
                    differential/*.py
                    differential/*.json

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Agenticus.Error
                    Petrus.Agenticus.Internal.Validate
                    Petrus.Agenticus.Internal.Atomic
                    Petrus.Agenticus.Catalog.Descriptor
                    Petrus.Agenticus.Catalog.Result
                    Petrus.Agenticus.Catalog.Resolution
                    Petrus.Agenticus.Runtime.Profiles
                    Petrus.Agenticus.Internal.PyRepr
                    Petrus.Agenticus.Internal.Sqlite
                    Petrus.Agenticus.Connection.Key
                    Petrus.Agenticus.Connection.Materialization
                    Petrus.Agenticus.Connection.Storage
                    Petrus.Agenticus.Connection.Custody
                    Petrus.Agenticus.Effect.Model
                    Petrus.Agenticus.Effect.Gateway
                    Petrus.Agenticus.Internal.Shape
                    Petrus.Agenticus.Thread.Identity
                    Petrus.Agenticus.Thread.Continuation
                    Petrus.Agenticus.Thread.Lifecycle
                    Petrus.Agenticus.Program.Descriptor
                    Petrus.Agenticus.Program.Seam
                    Petrus.Agenticus.Runtime.Installation
                    Petrus.Agenticus.Runtime.Result
                    Petrus.Agenticus.Runtime.Operation
                    Petrus.Agenticus.Hands.Contract
                    Petrus.Agenticus.Hands.Grants
                    Petrus.Agenticus.Hands.Gateway
                    Petrus.Agenticus.Hands.Conformance
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , crypton >=1.0
                  , ram >=0.20
                  , petrus-json
                  , stm >=2.5
                  , text >=2.0
                  , unix >=2.8
                  , filepath >=1.4
                  , directory >=1.3
                  , direct-sqlite >=2.3.29
  ghc-options:      -O2

test-suite petrus-agenticus-core-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Petrus.Agenticus.Support
                    Petrus.Agenticus.CatalogSpec
                    Petrus.Agenticus.EffectSpec
                    Petrus.Agenticus.ThreadSpec
                    Petrus.Agenticus.ProgramSpec
                    Petrus.Agenticus.RuntimeFoundationSpec
                    Petrus.Agenticus.ThreadDifferentialSpec
                    Petrus.Agenticus.Hands.Fixtures
                    Petrus.Agenticus.HandsSpec
                    Petrus.Agenticus.Hands.ConformanceSpec
                    Petrus.Agenticus.Hands.DifferentialSpec
                    Petrus.Agenticus.ConnectionSupport
                    Petrus.Agenticus.ConnectionSpec
                    Petrus.Agenticus.CustodyScript
                    Petrus.Agenticus.CustodyCorpusSpec
                    Petrus.Agenticus.CustodyInteropSpec
  build-depends:    base
                  , async >=2.2
                  , bytestring
                  , containers
                  , crypton
                  , directory
                  , filepath
                  , hspec >=2.10
                  , petrus-agenticus-core
                  , petrus-json
                  , petrus-test-support
                  , process
                  , QuickCheck >=2.14
                  , ram
                  , stm
                  , text
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark petrus-agenticus-core-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  other-modules:    Bench.Catalog
                    Bench.Effect
                    Bench.Thread
                    Bench.Hands
                    Bench.Custody
  build-depends:    base
                  , async >=2.2
                  , bytestring
                  , containers
                  , crypton
                  , deepseq
                  , directory
                  , filepath
                  , ram
                  , petrus-agenticus-core
                  , petrus-json
                  , tasty-bench >=0.3.2
                  , tasty
                  , text
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-A32m"
