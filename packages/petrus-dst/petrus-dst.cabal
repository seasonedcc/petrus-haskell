cabal-version:      3.4
name:               petrus-dst
version:            0.1.0.0
synopsis:           Deterministic simulation testing kit for Petrus (petrus.testing.dst/v4)
description:
  A Haskell port of Petrus's @petrus.testing.dst@: the deterministic World
  interpreter, strict @petrus-dst-world@ artifacts (versions 1 to 4) with
  codecs byte-identical to the Python reference, exact replay, the
  @sha256-counter-v1@ choice streams, and the outer process runner
  (@petrus-dst-process-runner@ protocol version 1).
  .
  The kit is runtime-neutral: it depends on no Petrus runtime package. The
  system under test plugs in through the 'Petrus.Testing.Dst.Profile' record.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Testing
build-type:         Simple
extra-doc-files:    PARITY.md
                    DIVERGENCES.md

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Testing.Dst
                    Petrus.Testing.Dst.Choice
                    Petrus.Testing.Dst.Codec
                    Petrus.Testing.Dst.Decode
                    Petrus.Testing.Dst.Internal.Canonical
                    Petrus.Testing.Dst.Internal.StrictJson
                    Petrus.Testing.Dst.Internal.World
                    Petrus.Testing.Dst.Profile
                    Petrus.Testing.Dst.PyRepr
                    Petrus.Testing.Dst.Replay
                    Petrus.Testing.Dst.Runner
                    Petrus.Testing.Dst.Timeline
                    Petrus.Testing.Dst.Transcript
                    Petrus.Testing.Dst.Types
                    Petrus.Testing.Dst.World
  build-depends:    base >=4.18 && <5
                  , array >=0.5
                  , base16-bytestring >=1.0
                  , bytestring >=0.11
                  , containers >=0.6
                  , crypton >=1.0
                  , directory >=1.3
                  , filepath >=1.4
                  , mtl >=2.3
                  , petrus-json
                  , process >=1.6.12
                  , ram >=0.20
                  , text >=2.0
                  , transformers >=0.6
                  , unix >=2.8
  ghc-options:      -O2

-- The Engine-backed worlds: the Haskell twins of the reference's
-- tests/dst/*_world.py profiles, driving the real Engine. A separate public
-- sublibrary, so the kit itself stays runtime-neutral.
library engine-worlds
  import:           warnings
  visibility:       public
  hs-source-dirs:   engine
  exposed-modules:  Petrus.Testing.Dst.Engine.Bridge
                    Petrus.Testing.Dst.Engine.Common
                    Petrus.Testing.Dst.Engine.Delayed
                    Petrus.Testing.Dst.Engine.Delivery
                    Petrus.Testing.Dst.Engine.GeneratedRuntime
                    Petrus.Testing.Dst.Engine.GeneratedRuntimeQualification
                    Petrus.Testing.Dst.Engine.Lifecycle
                    Petrus.Testing.Dst.Engine.Projection
                    Petrus.Testing.Dst.Engine.ReplayWorld
                    Petrus.Testing.Dst.Engine.Retry
                    Petrus.Testing.Dst.Engine.Timer
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , directory >=1.3
                  , filepath >=1.4
                  , mtl >=2.3
                  , petrus-activity
                  , petrus-dst
                  , petrus-engine
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-observation
                  , temporary >=1.3
                  , text >=2.0

-- The generated-schedule campaigns, failure bundles, legacy replay, and
-- boundary qualification: the Haskell twins of the reference's
-- tests/dst/{campaign,failure,replay,boundaries}.py and its Hypothesis
-- state machines, as Hedgehog state machines over the Engine worlds.
library campaigns
  import:           warnings
  visibility:       public
  hs-source-dirs:   campaigns
  exposed-modules:  Petrus.Testing.Dst.Boundaries
                    Petrus.Testing.Dst.Campaign
                    Petrus.Testing.Dst.Campaign.Machines
                    Petrus.Testing.Dst.Campaign.Support
                    Petrus.Testing.Dst.Failure
                    Petrus.Testing.Dst.LegacyReplay
  other-modules:    Paths_petrus_dst
  autogen-modules:  Paths_petrus_dst
  build-depends:    base >=4.18 && <5
                  , barbies >=2.0
                  , bytestring >=0.11
                  , containers >=0.6
                  , crypton >=1.0
                  , directory >=1.3
                  , filepath >=1.4
                  , hedgehog >=1.4
                  , petrus-activity
                  , petrus-dst
                  , petrus-dst:engine-worlds
                  , petrus-engine
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , process >=1.6.12
                  , ram >=0.20
                  , temporary >=1.3
                  , text >=2.0
                  , time >=1.12
                  , unix >=2.8

-- The DST tooling routes: replay, legacy replay, failure bundles,
-- campaigns, and production-boundary qualification.
executable petrus-dst-world
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , petrus-dst
                  , petrus-dst:campaigns
                  , petrus-dst:engine-worlds
                  , petrus-json
                  , text >=2.0
  ghc-options:      -threaded -rtsopts

-- The joined History/Dispatch transaction-fault worlds: the Haskell twins
-- of the reference's tests/dst/joined_*world.py, driving the real Absurd
-- Engine over PostgreSQL History and Absurd Workers.
library joined-worlds
  import:           warnings
  visibility:       public
  hs-source-dirs:   joined
  exposed-modules:  Petrus.Testing.Dst.Joined.Identities
                    Petrus.Testing.Dst.Joined.Checkers
                    Petrus.Testing.Dst.Joined.Support
                    Petrus.Testing.Dst.Joined.World
                    Petrus.Testing.Dst.Joined.Stories
                    Petrus.Testing.Dst.Joined.Creation
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , mtl >=2.3
                  , petrus-activity
                  , petrus-dst
                  , petrus-dst:engine-worlds
                  , petrus-engine
                  , petrus-engine-absurd
                  , petrus-history-postgres
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-motus-absurd
                  , petrus-postgres
                  , text >=2.0

test-suite petrus-dst-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Generated
                    Spec.Boundaries
                    Spec.Campaigns
                    Spec.Choice
                    Spec.Codec
                    Spec.EngineCheckers
                    Spec.EngineWorlds
                    Spec.Failure
                    Spec.JoinedWorlds
                    Spec.LegacyReplay
                    Spec.ManualReplay
                    Spec.Properties
                    Spec.Qualification
                    Spec.Runner
                    Spec.Stories
                    Spec.Support
                    Spec.Tooling
                    Spec.Transcript
                    Toy
  build-tool-depends: petrus-dst:petrus-dst-world
  build-depends:    base
                  , base16-bytestring
                  , bytestring
                  , containers
                  , crypton
                  , directory
                  , filepath
                  , barbies >=2.0
                  , hedgehog >=1.4
                  , hspec >=2.10
                  , mtl
                  , petrus-dst
                  , petrus-dst:campaigns
                  , petrus-dst:engine-worlds
                  , petrus-dst:joined-worlds
                  , petrus-history-postgres
                  , petrus-json
                  , petrus-motus-absurd
                  , petrus-postgres
                  , petrus-test-support
                  , process
                  , QuickCheck >=2.14
                  , temporary >=1.3
                  , ram
                  , text
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark petrus-dst-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench test
  main-is:          Bench.hs
  other-modules:    Generated
                    Spec.EngineWorlds
                    Spec.JoinedWorlds
                    Spec.Support
                    Toy
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , hspec
                  , mtl
                  , petrus-dst
                  , petrus-dst:engine-worlds
                  , petrus-dst:joined-worlds
                  , petrus-history-postgres
                  , petrus-json
                  , petrus-motus-absurd
                  , petrus-postgres
                  , petrus-test-support
                  , QuickCheck
                  , tasty-bench >=0.3.2
                  , tasty
                  , temporary >=1.3
                  , text
  ghc-options:      -O2 -rtsopts
