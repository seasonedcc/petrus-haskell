cabal-version:      3.4
name:               petrus-activity
version:            0.1.0.0
synopsis:           Petri- and history-agnostic Activity values for Petrus
description:
  The Activity values the Impetus kernel records in History and Motus
  executes: invocations, execution and retry policies, classified failures,
  declarations, typed definitions, payload converters, and heartbeat details
  (a port of @petrus.motus.activity@). It sits below the kernel so execution
  machinery can build on it without depending on Petri nets.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Control
build-type:         Simple

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Activity
                    Petrus.Activity.Number
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , deepseq >=1.4
                  , petrus-json
                  , text >=2.0
  ghc-options:      -O2

test-suite petrus-activity-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    base
                  , hspec >=2.10
                  , QuickCheck >=2.14
                  , petrus-activity
                  , petrus-json
                  , text
