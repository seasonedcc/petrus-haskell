cabal-version:      3.4
name:               petrus-json
version:            0.1.0.0
synopsis:           Strict, Python-compatible JSON values for Petrus wire formats
description:
  A JSON value type that keeps the integer/float distinction, preserves object
  member order, and offers strict parsing (duplicate members, non-finite
  numbers, surrogates, integer-only documents) plus a serializer that is
  byte-for-byte identical to CPython's @json.dumps@ for every option Petrus uses.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Data
build-type:         Simple

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Json
                    Petrus.Json.Encode
                    Petrus.Json.Parse
                    Petrus.Json.Value
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , text >=2.0
  ghc-options:      -O2

test-suite petrus-json-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Petrus.Json.ReferenceParse
  build-depends:    base
                  , bytestring
                  , hspec >=2.10
                  , QuickCheck >=2.14
                  , containers
                  , petrus-json
                  , text
  ghc-options:      -rtsopts
