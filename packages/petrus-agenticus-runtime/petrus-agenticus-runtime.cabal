cabal-version:      3.4
name:               petrus-agenticus-runtime
version:            0.1.0.0
synopsis:           Petrus Agenticus runtime hosts: the Agent-as-a-Net runner and provider runtimes
description:
  A Haskell port of @petrus.agenticus.runtime@. The durable Local
  Agent-as-a-Net runner lets Engine History alone schedule the loop and
  projects every committed fact exactly once into Thread accounting, with
  the Episode Attachment settled before the Thread outcome is recorded.
  The provider runtimes are Pi (native A2/A4, the A5 application, the model
  phase, recovery and the A2 host), Codex (local and Gondolin), Claude and
  Amp. PARITY.md maps each upstream test, and DIVERGENCES.md lists what
  differs. A module's @.Internal@ companion holds what only its tests and
  the differential corpus reach.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned; portions 2026 Henrique Bastos (see NOTICE)
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Control
build-type:         Simple
extra-doc-files:    NOTICE
                    PARITY.md
                    DIVERGENCES.md
                    bench/RESULTS.md
                    parity/pi.md
                    divergences/pi.md
                    bench/results-pi.md
                    parity/codex.md
                    parity/claude-a2.md
                    parity/amp.md
                    divergences/codex.md
                    divergences/claude-a2.md
                    divergences/amp.md
                    bench/results-hosts.md
data-files:         data/*.mjs
                    data/*.py
extra-source-files: differential/*.json
                    differential/*.py
                    differential/*.sqlite3
                    bench/*.py
                    test/fixtures/pi/*.mjs
                    test/fixtures/pi/*.py
                    test/fixtures/amp/amp_sdk/*.py
                    test/fixtures/amp/amp_sdk-0.1.20260729121202.dist-info/METADATA
                    test/fixtures/claude/claude_agent_sdk/*.py
                    test/fixtures/claude/claude_agent_sdk/_bundled/claude
                    test/fixtures/claude/claude_agent_sdk-0.2.128.dist-info/METADATA
                    test/fixtures/codex/*.py
                    test/fixtures/codex/*.mjs

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors
                      MultiWayIf

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Agenticus.Runtime.AgentNetRunner
                    Petrus.Agenticus.Runtime.Amp
                    Petrus.Agenticus.Runtime.Amp.Internal
                    Petrus.Agenticus.Runtime.Claude
                    Petrus.Agenticus.Runtime.Codex
                    Petrus.Agenticus.Runtime.CodexGondolin
                    Petrus.Agenticus.Runtime.Custody
                    Petrus.Agenticus.Runtime.Internal.Lifecycle
                    Petrus.Agenticus.Runtime.Internal.Process
                    Petrus.Agenticus.Runtime.Pi
                    Petrus.Agenticus.Runtime.Pi.Internal
                    Petrus.Agenticus.Runtime.PiA2Host
                    Petrus.Agenticus.Runtime.PiA2Host.Internal
                    Petrus.Agenticus.Runtime.PiApplication
                    Petrus.Agenticus.Runtime.PiApplication.Internal
                    Petrus.Agenticus.Runtime.PiModelPhase
                    Petrus.Agenticus.Runtime.PiModelPhase.Internal
                    Petrus.Agenticus.Runtime.PiRecovery
                    Petrus.Agenticus.Runtime.PiRecovery.Internal
  other-modules:    Paths_petrus_agenticus_runtime
                    Petrus.Agenticus.Runtime.Internal.HostSupport
  autogen-modules:  Paths_petrus_agenticus_runtime
  build-depends:    base >=4.18 && <5
                  , async >=2.2
                  , bytestring >=0.11
                  , containers >=0.6
                  , crypton >=1.0
                  , directory >=1.3
                  , filepath >=1.4
                  , network >=3.1
                  , ram >=0.20
                  , petrus-activity
                  , petrus-agenticus
                  , petrus-agenticus-core
                  , petrus-engine
                  , petrus-execution
                  , petrus-history-store
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-posix
                  , process
                  , stm
                  , temporary
                  , text >=2.0
                  , unix >=2.8

test-suite petrus-agenticus-runtime-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Petrus.Agenticus.Runtime.AgentNetRunnerSpec
                    Petrus.Agenticus.Runtime.AmpSpec
                    Petrus.Agenticus.Runtime.ClaudeSpec
                    Petrus.Agenticus.Runtime.CodexSpec
                    Petrus.Agenticus.Runtime.HostsDifferentialSpec
                    Petrus.Agenticus.Runtime.Live.AgentNetSpec
                    Petrus.Agenticus.Runtime.Live.AmpSpec
                    Petrus.Agenticus.Runtime.Live.ClaudeSpec
                    Petrus.Agenticus.Runtime.Live.CodexSpec
                    Petrus.Agenticus.Runtime.Live.PiSpec
                    Petrus.Agenticus.Runtime.Live.Support
                    Petrus.Agenticus.Runtime.PiA2HostSpec
                    Petrus.Agenticus.Runtime.PiApplicationSpec
                    Petrus.Agenticus.Runtime.PiDifferentialSpec
                    Petrus.Agenticus.Runtime.PiModelPhaseSpec
                    Petrus.Agenticus.Runtime.PiSpec
                    Petrus.Agenticus.Runtime.PiSupport
                    Petrus.Agenticus.Runtime.RunnerDifferentialSpec
  build-depends:    base
                  , bytestring
                  , containers
                  , crypton >=1.0
                  , directory
                  , filepath
                  , hspec >=2.10
                  , network
                  , petrus-activity
                  , petrus-agenticus
                  , petrus-agenticus-core
                  , petrus-agenticus-runtime
                  , petrus-engine
                  , petrus-execution
                  , petrus-impetus
                  , petrus-json
                  , petrus-motus
                  , petrus-test-support
                  , process
                  , ram >=0.20
                  , temporary
                  , text
                  , time
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark petrus-agenticus-runtime-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  other-modules:    HostsBench
                    PiA2Bench
                    PiBench
                    PiTurnsBench
                    TurnsBench
                    Twin
  build-depends:    base
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , petrus-activity
                  , petrus-agenticus
                  , petrus-agenticus-core
                  , petrus-agenticus-runtime
                  , petrus-execution
                  , petrus-json
                  , petrus-test-support
                  , ram >=0.20
                  , tasty >=1.4
                  , tasty-bench >=0.3
                  , temporary
                  , text
                  , unix
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-A32m"
