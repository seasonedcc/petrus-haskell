cabal-version:      3.4
name:               hamsterdan-cli
version:            0.1.0.0
synopsis:           CPython 3.14's argparse for Hamsterdan's operator command lines
description:
  The parsing, help, usage and error behavior of CPython 3.14's
  @argparse.ArgumentParser@ for the command lines of
  @python -m hamsterdan.host.export@ and @python -m hamsterdan.operator@:
  store, append and flag options typed as @str@, @int@ or @pathlib.Path@,
  choices, required options, the automatic @-h/--help@, and subcommands,
  with @HelpFormatter@ and @textwrap@ wrapping to the same width.
license:            Apache-2.0
license-file:       LICENSE
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Console
build-type:         Simple

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Hamsterdan.Cli.Argparse
  build-depends:    base >=4.18 && <5
                  , array >=0.5
                  , containers >=0.6
                  , hamsterdan-contracts
                  , hamsterdan-github
                  , text >=2.0
  ghc-options:      -O2
