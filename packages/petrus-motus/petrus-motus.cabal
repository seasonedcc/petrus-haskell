cabal-version:      3.4
name:               petrus-motus
version:            0.1.0.0
synopsis:           Petri-agnostic Activity custody: the Dispatch port and its in-process adapters
description:
  The core of a port of @petrus.motus.dispatch@: the Dispatch port the Engine
  drives (dispatch, collect, and the optional recoverable cancellation
  extension), the cancellation values, the provider-neutral Activity Attempt
  and Worker custody surface, the two in-process adapters, InlineDispatch
  and InMemoryDispatch, and the durable local SQLite Dispatch
  (LocalDispatch and LocalWorkerDispatch), which shares its file format with
  the reference. Other providers (ZeroMQ, Absurd) and Workers build on these
  values in their own packages.
license:            Apache-2.0
license-file:       LICENSE
copyright:          2026 Seasoned; portions 2026 Henrique Bastos (see NOTICE)
author:             Seasoned
maintainer:         danielweinmann@avatarnaturalfoods.com
category:           Control
build-type:         Simple
extra-doc-files:    NOTICE

common warnings
  ghc-options:        -Wall -Wcompat -Widentities -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
                      -Werror
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      LambdaCase
                      StrictData
                      DuplicateRecordFields
                      OverloadedRecordDot
                      NoFieldSelectors

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Petrus.Motus.Dispatch
                    Petrus.Motus.Dispatch.Inline
                    Petrus.Motus.Dispatch.InMemory
                    Petrus.Motus.Dispatch.Local
                    Petrus.Motus.Internal.Argparse
                    Petrus.Motus.Internal.Repr
                    Petrus.Motus.PythonException
                    Petrus.Motus.Worker
                    Petrus.Motus.Worker.Cli
  build-depends:    base >=4.18 && <5
                  , bytestring >=0.11
                  , containers >=0.6
                  , direct-sqlite >=2.3.29 && <2.4
                  , directory >=1.3
                  , filepath >=1.4
                  , petrus-activity
                  , petrus-json
                  , petrus-sqlite
                  , petrus-telemetry
                  , stm >=2.5
                  , text >=2.0
                  , unix >=2.8
  ghc-options:      -O2

test-suite petrus-motus-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Petrus.Motus.Dispatch.LocalSupport
                    Petrus.Motus.Dispatch.LocalSpec
                    Petrus.Motus.Dispatch.LocalInteropSpec
                    Petrus.Motus.WorkerSupport
                    Petrus.Motus.WorkerSpec
                    Petrus.Motus.AsyncWorkerSpec
                    Petrus.Motus.WorkerCliSpec
                    Petrus.Motus.BoundarySpec
  build-depends:    base
                  , bytestring
                  , containers
                  , direct-sqlite
                  , directory
                  , filepath
                  , hspec >=2.10
                  , petrus-activity
                  , petrus-json
                  , petrus-motus
                  , petrus-telemetry
                  , petrus-test-support
                  , process >=1.6
                  , text
                  , time >=1.12
                  , unix
  ghc-options:      -threaded -rtsopts

benchmark petrus-motus-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  build-depends:    base
                  , direct-sqlite
                  , directory
                  , filepath
                  , petrus-activity
                  , petrus-json
                  , containers
                  , petrus-motus
                  , tasty-bench >=0.3.2
                  , tasty
                  , text
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-A32m"
