RATIO = re.compile(r"^\**\s*(\d+(?:\.\d+)?)\s*[×x]\s*\**$")
WON = re.compile(r"^(\d+) of (\d+)$")


def load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


COMPARE = load("petrus_bench_compare", ROOT / "scripts" / "bench-compare")
BENCH = load("petrus_bench", ROOT / "scripts" / "bench")


def tasty_pattern(names: List[str]) -> List[str]:
    paths = [n for n in names if n.startswith("All.")]
    if not paths:
        return []
    quoted = ['"' + n.replace("\\", "\\\\").replace('"', '\\"') + '"' for n in paths]
    return ["-p", " || ".join(f"$0 == {q}" for q in quoted)]


def shell(command: str, env: Dict[str, str], log) -> str:
    log.write(f"+ {command}\n")
    log.flush()
    completed = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", command], cwd=ROOT, env=env,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    log.write(completed.stdout)
    if completed.returncode != 0:
        raise RuntimeError(f"`{command}` exited {completed.returncode}")
    return completed.stdout


def scratch(entry: dict) -> Path:
    directory = TMP / entry["package"]
    shutil.rmtree(directory, ignore_errors=True)
    (directory / "tmp").mkdir(parents=True)
    return directory


def run_pair(entry: dict, reps: int, binary, log) -> Dict[str, dict]:
    executable, haskell_env = binary
    directory = scratch(entry)
    env = dict(BENCH.environment()) if not os.environ.get("CI") else dict(os.environ)
    env["BENCH_TMP"] = str(directory)
    if entry["only"]:
        env["PETRUS_BENCH_ONLY"] = entry["only"]
    haskell_env = dict(haskell_env)
    if entry["tmpdir"]:
        env["TMPDIR"] = haskell_env["TMPDIR"] = str(directory / "tmp")
    names = [h for h, _ in entry["rows"]]
    ours: Dict[str, List[float]] = {h: [] for h in names}
    theirs: Dict[str, List[float]] = {h: [] for h in names}
    for rep in range(1, reps + 1):
        for side in (("haskell", "python") if rep % 2 else ("python", "haskell")):
            if side == "haskell":
                output = directory / f"haskell.{rep}.csv"
                command = ([str(executable)] + tasty_pattern(names) + ["--csv", str(output), "--stdev", "5",
                           "--timeout", "300", "--time-mode", "wall"] + entry["haskell"] + ["+RTS", "-M2G", "-RTS"])
                log.write("+ " + " ".join(command) + "\n")
                log.flush()
                completed = subprocess.run(command, cwd=ROOT / "packages" / entry["package"], env=haskell_env,
                                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                log.write(completed.stdout)
                if completed.returncode != 0:
                    raise RuntimeError(f"{executable.name} exited {completed.returncode}")
                found = COMPARE.figures(completed.stdout)
                if output.exists():
                    with output.open(newline="") as stream:
                        for row in csv.DictReader(stream):
                            found[row["Name"]] = float(row["Mean (ps)"]) / 1000.0
                for h in names:
                    value = found.get(h, found.get(h[len("All."):] if h.startswith("All.") else None))
                    if value is not None:
                        ours[h].append(value)
            else:
                found = COMPARE.figures(shell(entry["python"], env, log))
                for h, p in entry["rows"]:
                    if p in found:
                        theirs[h].append(found[p])
    shutil.rmtree(directory, ignore_errors=True)
    result = {}
    for h, p in entry["rows"]:
        if len(ours[h]) != reps or len(theirs[h]) != reps:
            result[h] = {"error": f"measured {len(ours[h])} Haskell and {len(theirs[h])} Python figures of {reps}"
                                  f" (Haskell row `{h}`, Python row `{p}`)"}
            continue
        ratios = [theirs_i / ours_i for ours_i, theirs_i in zip(ours[h], theirs[h])]
        result[h] = {"haskell": statistics.median(ours[h]), "python": statistics.median(theirs[h]),
                     "ratio": statistics.median(ratios), "won": sum(r > 1 for r in ratios), "of": reps,
                     "ratios": ratios, "haskell_runs": ours[h], "python_runs": theirs[h]}
    return result


def run_table(entry: dict, log) -> Dict[str, dict]:
    directory = scratch(entry)
    env = dict(BENCH.environment()) if not os.environ.get("CI") else dict(os.environ)
    env["BENCH_TMP"] = str(directory)
    try:
        output = shell(entry["command"], env, log)
    finally:
        shutil.rmtree(directory, ignore_errors=True)
    result = {}
    for pattern in entry["rows"]:
        line = next((l for l in output.splitlines() if re.search(pattern, l)), None)
        cells = [c.strip() for c in line.strip().strip("|").split("|")] if line else []
        ratio = next((float(RATIO.match(c).group(1)) for c in cells[1:] if RATIO.match(c)), None)
        won = next((WON.match(c) for c in cells[1:] if WON.match(c)), None)
        name = cells[0] if cells else pattern
        if ratio is None or won is None:
            result[name] = {"error": f"no row matching `{pattern}` with a ratio and a \"k of n\" cell"
                                     " in the harness's table"}
        else:
            result[name] = {"ratio": ratio, "won": int(won.group(1)), "of": int(won.group(2)), "line": line.strip()}
    return result


def measure(entry: dict, reps: int, build: bool, log) -> Dict[str, dict]:
    try:
        if entry["kind"] == "table":
            if build:
                COMPARE.benchmark_binary(entry["package"], build=True)
            return run_table(entry, log)
        binary = COMPARE.benchmark_binary(entry["package"], build=build)
        return run_pair(entry, reps, binary, log)
    except (RuntimeError, subprocess.CalledProcessError, OSError) as problem:
        names = [h for h, _ in entry["rows"]] if entry["kind"] == "pair" else entry["rows"]
        return {name: {"error": str(problem)} for name in names}


def human(ns: Optional[float]) -> str:
    return COMPARE.human(ns) if ns is not None else "—"


def main(argv: List[str]) -> int:
    parser = argparse.ArgumentParser(usage=__doc__)
    parser.add_argument("packages", nargs="*")
    parser.add_argument("--reps", type=int, default=5)
    parser.add_argument("--shard")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--json")
    options = parser.parse_args(argv)
    entries = [e for e in ENTRIES if not options.packages or e["package"] in options.packages]
    unknown = set(options.packages) - {e["package"] for e in ENTRIES}
    if unknown:
        print(f"bench-gate: no entry for {', '.join(sorted(unknown))}", file=sys.stderr)
        return 2
    if options.shard:
        index, count = (int(x) for x in options.shard.split("/"))
        sharded = [e for e in entries if e.get("sharded", True)]
        entries = [e for i, e in enumerate(sharded) if i % count == index - 1]
    if options.list:
        for e in entries:
            rows = [h for h, _ in e["rows"]] if e["kind"] == "pair" else e["rows"]
            print(f"{e['package']} ({e['kind']}): " + "; ".join(rows))
        return 0
    postgres = any(BENCH.needs_postgres(e["package"], e.get("python", "") + e.get("command", "")) for e in entries)
    if postgres and not os.environ.get("PETRUS_TEST_POSTGRES"):
        return subprocess.call([str(ROOT / "scripts" / "with-postgres"), sys.executable, __file__, *argv])
    TMP.mkdir(parents=True, exist_ok=True)
    log_path = TMP / "bench-gate.log"
    rows = []
    with log_path.open("w") as log:
        for entry in entries:
            print(f"==> {entry['package']}", file=sys.stderr, flush=True)
            load_before = os.getloadavg()[0]
            measured = measure(entry, options.reps, not options.no_build, log)
            load_after = os.getloadavg()[0]
            for name, result in measured.items():
                if "error" in result:
                    verdict = "error"
                else:
                    verdict = "ok" if 2 * result["won"] > result["of"] else "FAIL"
                rows.append({"package": entry["package"], "row": name, "result": result, "verdict": verdict,
                             "load": [load_before, load_after]})
                shown = (f"{result['ratio']:.2f}×, won {result['won']} of {result['of']}" if "error" not in result
                         else result["error"])
                print(f"    {name}: {shown} — {verdict}", file=sys.stderr, flush=True)
    lines = [
        f"### Benchmark gate ({options.reps} interleaved repetitions per pair; harness tables as printed)",
        "",
        "A row passes when Haskell won more than half of its repetitions.",
        "",
        "| Package | Row | Haskell | Python | Python / Haskell (median) | Haskell won | Load (1 min) | Verdict |",
        "| --- | --- | ---: | ---: | ---: | ---: | --- | --- |",
    ]
    for r in rows:
        result = r["result"]
        ratio = f"{result['ratio']:.2f}×" if "ratio" in result else "—"
        won = f"{result['won']} of {result['of']}" if "won" in result else "—"
        detail = result.get("error", "")
        lines.append(f"| `{r['package']}` | {r['row']} | {human(result.get('haskell'))} | {human(result.get('python'))} | "
                     f"{ratio} | {won} | {r['load'][0]:.1f}–{r['load'][1]:.1f} | {r['verdict']}"
                     + (f": {detail}" if detail else "") + " |")
    failed = [r for r in rows if r["verdict"] in ("FAIL", "error")]
    lines += ["", f"{len(rows)} rows, {len(failed)} failed. Log: `{log_path.relative_to(ROOT)}`.", ""]
    text = "\n".join(lines)
    print(text)
    if os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as summary:
            summary.write(text + "\n")
    if options.json:
        Path(options.json).write_text(json.dumps(rows, indent=1) + "\n")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
