#!/usr/bin/env python3
"""Check every upstream test count the parity ledgers cite against a record.

    scripts/upstream-test-counts --check   # (check-parity runs this) no Python environment needed
    scripts/upstream-test-counts --write   # recollect with pytest and rewrite the record

The ledgers (PARITY.md, packages/*/PARITY.md, packages/*/parity/*.md and
packages/*/parity-*.md) say how many tests upstream files have. A *test* (or
*function*) is a test function or method; a *case* (or *item*) is what pytest
collects, one per parametrization. ``--write`` runs ``pytest --collect-only``
over each pinned upstream project (upstream/petrus, upstream/petrus-engine,
upstream/hamsterdan) in its pinned environment (scripts/upstream-python) and
records every test file's two counts, with the commits they were collected
at, in docs/upstream-test-counts.json. ``--check`` reads only git and that
record, so it needs neither the submodules' environments nor Python packages.
It fails:

- when an upstream submodule has moved since the record was made (rerun
  ``--write``);
- when a cited count differs from the record, or a cited file is not in it
  or is ambiguous (cite more of its path);
- when a ledger states a count it cannot read, so that no count goes
  unchecked: write it in one of the forms below.

A count is read from these forms, where F is a test file named by its path
or by enough of the path's end to be unique (`tests/unit/test_pi.py`,
`test_pi.py`), with or without backticks:

    F (5 functions, 8 cases)        F (11 tests, 14 cases)     F (3 functions)
    F (69 of 70 cases               F ported (82 cases)        F's 14 cases
    F: 20 functions / 29 cases      F: 12 functions, 13 cases  F: 3 functions
    F, 26 tests                     F, 36 tests (40 cases)     F, 11 of 12 tests
    F, 23 of 26 tests (29 collected)                           F: all 19 tests
    F has 36 test functions and 40 cases
    all 11 F tests (14 cases)       26 F tests                 all 13 F cases
    All 22 tests of F               F and G ported (135 cases)    (the sum)

and from tables whose header names the unit of a column: "Functions",
"Tests" or "Test functions"; "Cases", "Items" or "Collected"; or "Upstream
count" ("78 functions, 103 cases"). A cell may read "8 of 10": the total is
the second number, and "N of M" in the forms above checks M, the file's
total. A count of a subset says so ("the 3 Engine-level tests", "4 Worker
cases of 36") and is not checked. Any other count of tests, cases, functions
or items in the clause after a file name, and any "N upstream tests" (or
cases, functions, items), is refused: write it in a form above, or as a
subset.

The file is looked up in upstream/hamsterdan for a ``hamsterdan-*`` package's
ledger or the root ledger's hamsterdan section, else in upstream/petrus, then
upstream/petrus-engine. What a port's own suite runs is not stated in the
ledgers (scripts/lint-example-counts); `cabal test` and CI report it.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Dict, Iterator, List, NamedTuple, Optional, Set, Tuple

ROOT = Path(__file__).resolve().parent.parent
RECORD = ROOT / "docs" / "upstream-test-counts.json"
PROJECTS = ["petrus", "petrus-engine", "hamsterdan"]

N = r"(\d+)"
FILE = r"`?((?:[\w.\-]+/)*test_\w+\.py)`?(?!::|\w)"
FILES = r"((?:`?(?:[\w.\-]+/)*test_\w+\.py`?(?:, | and | and the | \+ ))*`?(?:[\w.\-]+/)*test_\w+\.py`?)"
TESTS = r"(?:test )?(?:functions?|tests?)"
CASES = r"(?:cases|items)"
UNIT = r"(?:upstream )?(?:test functions?|tests?|functions?|cases?|items?|collected)\b"

# A pattern matched right after a file name: (regex, groups that are totals as (group, unit)).
AFTER = [
    (re.compile(r"\s*\((?:\d+ of )?" + N + " " + TESTS + r"(?:, (?:\d+ of )?" + N + " " + CASES + r")?"),
     [(1, "tests"), (2, "cases")]),
    (re.compile(r"\s*(?:ported )?\((?:\d+ of )?" + N + " " + CASES + r"\b"), [(1, "cases")]),
    (re.compile(r":? " + N + " functions(?: /|,) " + N + " cases"), [(1, "tests"), (2, "cases")]),
    (re.compile(r",? (?:\d+ of )?" + N + " " + TESTS + r"(?: \(" + N + r" (?:cases|collected)\))?"),
     [(1, "tests"), (2, "cases")]),
    (re.compile(r" has " + N + " test functions and " + N + " cases"), [(1, "tests"), (2, "cases")]),
    (re.compile(r"(?:'s|’s) " + N + r" tests\b"), [(1, "tests")]),
    (re.compile(r"(?:'s|’s) " + N + r" cases\b"), [(1, "cases")]),
    (re.compile(r":? (?:all )?" + N + " " + TESTS + r"\b"), [(1, "tests")]),
]
BARE = re.compile(r"\s*(?:\(\d+[,)]|, \d+ of \d+(?! \w))")
# Patterns that name the file inside them.
AROUND = [
    (re.compile(r"(?:all )?" + N + " " + FILE + " (tests|cases)(?: \\(" + N + " " + CASES + r"\))?"), None),
    (re.compile(r"All " + N + " tests of " + FILE), None),
    (re.compile(FILES + r" ported \(" + N + r" cases\b"), None),
]
UNIT_COUNT = re.compile(r"(?<![\w.§])" + N + r" " + UNIT)
SEPARATOR = re.compile(r"^\|\s*:?-{3}")
COLUMNS = {"functions": "tests", "tests": "tests", "test functions": "tests",
           "cases": "cases", "items": "cases", "collected": "cases", "upstream count": "count"}


class Claim(NamedTuple):
    doc: str
    line: int
    projects: Tuple[str, ...]
    files: Tuple[str, ...]
    unit: str
    count: int


class Segment(NamedTuple):
    text: str
    lines: List[int]  # the line of each character


def ledgers() -> List[str]:
    listed = subprocess.run(["git", "ls-files", "--", "PARITY.md", "packages/*/PARITY.md", "packages/*/parity/*.md",
                             "packages/*/parity-*.md"], cwd=ROOT, check=True, stdout=subprocess.PIPE,
                            text=True).stdout.split()
    return sorted(set(listed))


def cells(row: str) -> List[Tuple[int, str]]:
    """A table row's cells with their offsets; pipes inside backticks or escaped do not split."""
    found, start, tick, i = [], 1, False, 1
    body = row.rstrip()
    while i < len(body):
        c = body[i]
        if c == "\\":
            i += 2
            continue
        if c == "`":
            tick = not tick
        elif c == "|" and not tick:
            found.append((start, body[start:i]))
            start = i + 1
        i += 1
    return found


def projects_for(doc: str, heading: str) -> Tuple[str, ...]:
    if doc.startswith("packages/hamsterdan-") or (doc == "PARITY.md" and heading == "hamsterdan"):
        return ("hamsterdan",)
    if doc == "PARITY.md" and heading == "petrus-viewer":
        return ()
    if doc == "PARITY.md" and heading == "petrus-engine":
        return ("petrus-engine", "petrus")
    return ("petrus", "petrus-engine")


def segments(lines: List[str]) -> Iterator[Tuple[str, Segment, Optional[List[str]], Optional[int]]]:
    """(heading, segment, table header, column) for each paragraph, heading and table cell."""
    heading = ""
    paragraph: List[Tuple[int, str]] = []
    header: Optional[List[str]] = None

    def flush() -> Iterator[Tuple[str, Segment, Optional[List[str]], Optional[int]]]:
        if paragraph:
            text, owners = "", []
            for number, line in paragraph:
                piece = line.strip() + " "
                text += piece
                owners += [number] * len(piece)
            yield heading, Segment(text, owners), None, None
            paragraph.clear()

    for index, line in enumerate(lines):
        number = index + 1
        if line.startswith("|"):
            yield from flush()
            if index + 1 < len(lines) and SEPARATOR.match(lines[index + 1]):
                header = [text.strip().lower() for _, text in cells(line)]
                continue
            if SEPARATOR.match(line):
                continue
            for column, (_, text) in enumerate(cells(line)):
                yield heading, Segment(text, [number] * len(text)), header, column
            continue
        header = None
        if line.startswith("#"):
            yield from flush()
            if line.startswith("## "):
                heading = line[3:].strip().lower()
            yield heading, Segment(line, [number] * len(line)), None, None
        elif not line.strip():
            yield from flush()
        else:
            paragraph.append((number, line))
    yield from flush()


def scan(doc: str) -> Tuple[List[Claim], List[str]]:
    lines = (ROOT / doc).read_text(encoding="utf-8").split("\n")
    claims: List[Claim] = []
    problems: List[str] = []
    rows: Dict[int, List[Tuple[Optional[List[str]], int, str]]] = {}
    for heading, segment, header, column in segments(lines):
        projects = projects_for(doc, heading)
        if not projects:
            continue
        text = segment.text
        used: Set[int] = set()

        def claim(position: int, files: Tuple[str, ...], unit: str, count: str) -> None:
            claims.append(Claim(doc, segment.lines[position], projects, files, unit, int(count)))

        for pattern, _ in AROUND:
            for match in pattern.finditer(text):
                used.update(range(match.start(), match.end()))
                groups = match.groups()
                if pattern is AROUND[0][0]:
                    claim(match.start(), (groups[1],), "tests" if groups[2] == "tests" else "cases", groups[0])
                    if groups[3]:
                        claim(match.start(), (groups[1],), "cases", groups[3])
                elif pattern is AROUND[1][0]:
                    claim(match.start(), (groups[1],), "tests", groups[0])
                else:
                    claim(match.start(), tuple(re.findall(r"(?:[\w.\-]+/)*test_\w+\.py", groups[0])), "cases",
                          groups[1])
        for match in re.finditer(FILE, text):
            if match.start() in used:
                continue
            rest = text[match.end():]
            for pattern, totals in AFTER:
                after = pattern.match(rest)
                if after:
                    used.update(range(match.end(), match.end() + after.end()))
                    for group, unit in totals:
                        if after.group(group):
                            claim(match.start(), (match.group(1),), unit, after.group(group))
                    break
            else:
                if BARE.match(rest):
                    problems.append(f"{doc}:{segment.lines[match.start()]}: a count after {match.group(1)} names no "
                                    "unit (say tests or cases)")
        if header is not None and column is not None:
            rows.setdefault(segment.lines[0], []).append((header, column, text))
        for match in UNIT_COUNT.finditer(text):
            if match.start() in used:
                continue
            before = text[max(0, match.start() - 4):match.start()]
            after = text[match.end():match.end() + 3]
            subset = before.endswith(("the ", "of ")) or after.startswith(" of") or text[match.end():].startswith(")")
            if subset:
                continue
            window = text[max(0, match.start() - 60):match.start()]
            near = list(re.finditer(FILE, window))
            about_a_file = bool(near) and not re.search(r"[;.] ", window[near[-1].end():])
            if about_a_file or "upstream" in match.group(0):
                problems.append(f"{doc}:{segment.lines[match.start()]}: \"{match.group(0)}\" is not a count this "
                                "script can read; use a form from scripts/upstream-test-counts, or say it is a "
                                "subset (\"the N ...\")")
    for number, row in rows.items():
        header = row[0][0] or []
        files = [re.findall(FILE, text) for _, _, text in row]
        file_cells = [found for found in files if found]
        if not file_cells:
            continue
        for _, column, text in row:
            unit = COLUMNS.get(header[column] if column < len(header) else "")
            value = text.strip()
            if unit is None or not value:
                continue
            target = tuple(file_cells[0])
            if len(target) != 1:
                problems.append(f"{doc}:{number}: a count column for {len(target)} files; name one file per row")
                continue
            heading = ""
            for line in lines[:number]:
                if line.startswith("## "):
                    heading = line[3:].strip().lower()
            projects = projects_for(doc, heading)
            if unit == "count":
                found = re.fullmatch(r"(?:\d+ of )?" + N + r" functions?(?:, (?:\d+ of )?" + N + " cases)?", value)
                if not found:
                    problems.append(f"{doc}:{number}: cannot read the upstream count \"{value}\"")
                    continue
                claims.append(Claim(doc, number, projects, target, "tests", int(found.group(1))))
                if found.group(2):
                    claims.append(Claim(doc, number, projects, target, "cases", int(found.group(2))))
                continue
            found = re.fullmatch(r"\**(?:\d+ of )?" + N + r"\**", value)
            if not found:
                problems.append(f"{doc}:{number}: cannot read the count \"{value}\" in the {header[column]} column")
                continue
            claims.append(Claim(doc, number, projects, target, unit, int(found.group(1))))
    return claims, problems


def gitlinks() -> Dict[str, str]:
    listing = subprocess.run(["git", "ls-tree", "HEAD", "upstream/"], cwd=ROOT, check=True,
                             stdout=subprocess.PIPE, text=True).stdout
    return {line.split("\t")[1].split("/", 1)[1]: line.split()[2] for line in listing.splitlines()}


def lookup(files: Dict[str, dict], projects: Tuple[str, ...], name: str) -> Tuple[Optional[str], str]:
    """The recorded key of a cited file, or why there is none."""
    for project in projects:
        keys = [k for k in files if k.split(":")[0] == project
                and (k.split(":", 1)[1] == name or k.split(":", 1)[1].endswith("/" + name))]
        if len(keys) == 1:
            return keys[0], ""
        if keys:
            return None, f"{name} is ambiguous in upstream/{project} ({', '.join(k.split(':', 1)[1] for k in keys)})"
    return None, f"{name} is not a test file of {' or '.join('upstream/' + p for p in projects)}"


def collect(project: str) -> Dict[str, dict]:
    python = subprocess.run([str(ROOT / "scripts" / "upstream-python"), project], cwd=ROOT, check=True,
                            stdout=subprocess.PIPE, text=True).stdout.strip()
    result = subprocess.run([python, "-B", "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider"],
                            cwd=ROOT / "upstream" / project, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    ids = [line for line in result.stdout.splitlines() if "::" in line and not line.startswith(" ")]
    if result.returncode != 0 or not ids:
        raise SystemExit(f"upstream-test-counts: collecting upstream/{project} failed:\n{result.stdout}")
    files: Dict[str, List[str]] = {}
    for item in ids:
        files.setdefault(item.split("::", 1)[0], []).append(item)
    return {f"{project}:{path}": {"tests": len({re.sub(r'\[.*\]$', '', i) for i in items}), "cases": len(items)}
            for path, items in files.items()}


def write() -> int:
    record: dict = {"upstream": {p: c for p, c in sorted(gitlinks().items()) if p in PROJECTS}, "files": {}}
    for project in PROJECTS:
        record["files"].update(collect(project))
    record["files"] = dict(sorted(record["files"].items()))
    RECORD.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(f"recorded {len(record['files'])} upstream test files in {RECORD.relative_to(ROOT)}")
    return check()


def check() -> int:
    if not RECORD.exists():
        print(f"upstream-test-counts: {RECORD.relative_to(ROOT)} is missing (run scripts/upstream-test-counts --write)",
              file=sys.stderr)
        return 1
    record = json.loads(RECORD.read_text(encoding="utf-8"))
    problems: List[str] = []
    current = gitlinks()
    for project, commit in record["upstream"].items():
        if current.get(project) != commit:
            problems.append(f"upstream/{project} moved from {commit[:12]} to {current.get(project, '?')[:12]} since the"
                            " counts were recorded (rerun scripts/upstream-test-counts --write)")
    found: List[Claim] = []
    for doc in ledgers():
        claims, unread = scan(doc)
        found += claims
        problems += unread
    for claim in found:
        keys = []
        for name in claim.files:
            key, why = lookup(record["files"], claim.projects, name)
            if key is None:
                problems.append(f"{claim.doc}:{claim.line}: {why}")
            keys.append(key)
        if None in keys:
            continue
        actual = sum(record["files"][key][claim.unit] for key in keys)
        if actual != claim.count:
            problems.append(f"{claim.doc}:{claim.line}: cites {claim.count} {claim.unit} for "
                            f"{' + '.join(claim.files)}; upstream has {actual}")
    if problems:
        print("upstream-test-counts: the ledgers' upstream test counts do not match docs/upstream-test-counts.json:",
              file=sys.stderr)
        for problem in dict.fromkeys(problems):
            print("  " + problem, file=sys.stderr)
        return 1
    print(f"{len(found)} upstream test counts in {len(ledgers())} ledgers match the recorded collection")
    return 0


def main(argv: List[str]) -> int:
    if argv == ["--write"]:
        return write()
    if argv in ([], ["--check"]):
        return check()
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
