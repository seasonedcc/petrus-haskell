#!/usr/bin/env bash
# Provision a pinned upstream Python environment and print its interpreter.
#
#   scripts/upstream-python                 # upstream/petrus (the default)
#   scripts/upstream-python petrus-engine   # upstream/petrus-engine
#   scripts/upstream-python hamsterdan      # upstream/hamsterdan (its benchmarks,
#                                           # corpus generators and host interop)
#   scripts/upstream-python petrus-sdks     # upstream/petrus with the pinned
#                                           # agenticus-claude and agenticus-amp
#                                           # extras (the real provider SDKs)
#
# Each environment is upstream/<project>/.venv, synced from that project's own
# frozen uv.lock (upstream/petrus with the postgres extra; upstream/hamsterdan
# with its default groups, whose httpx the benchmarks' mock transport uses,
# and its own pinned Petrus). petrus-sdks is upstream/petrus synced from the
# same lock with its agenticus-claude and agenticus-amp extras, so
# claude-agent-sdk (with its bundled Claude Code) and amp-sdk are exactly the
# reference's pins. It lives apart, in dist-newstyle/upstream-python/
# petrus-sdks/.venv, so that the default environment, which the differential
# suites run against fake SDKs, keeps exactly the packages the committed
# fixtures were made with. It is reused when
# it already runs the pinned Python and imports what the suites need;
# otherwise it is (re)synced with uv.
#
# The Python version is pinned here, exactly, the single place for it (the
# test suites, scripts/check-all, scripts/bench and CI all provision through
# this script). Upstream only says requires-python >= 3.14 (petrus) or
# >= 3.12 (petrus-engine) or >= 3.14 (hamsterdan), so without a pin uv picks whatever is newest: on a
# machine without a 3.14 interpreter that is a freshly downloaded CPython
# 3.15, for which upstream/petrus's locked psycopg-binary 3.3.4 has no wheel,
# and the sync fails. The patch level matters too: several ports are
# differential against the standard library itself (http.server, tarfile,
# json), and CPython 3.14.8 changed how http.server answers a malformed
# request line, so "3.14" would make the reference drift with whatever patch
# release the machine happens to have. 3.14.6 is the release the ports and
# the committed fixtures were made against; moving it is a deliberate act
# that reruns every differential suite.
#
# Progress goes to stderr; stdout carries only the interpreter path.
set -euo pipefail

PYTHON_VERSION=3.14.6

project=${1:-petrus}
case "$project" in
  petrus)
    sync_args=(--extra postgres)
    imports="petrus, psycopg"
    ;;
  petrus-engine)
    sync_args=()
    imports="petrus.cli.format_json"
    ;;
  hamsterdan)
    sync_args=()
    imports="hamsterdan, fastapi, httpx"
    ;;
  petrus-sdks)
    sync_args=(--extra agenticus-claude --extra agenticus-amp)
    imports="petrus, claude_agent_sdk, amp_sdk"
    ;;
  *)
    echo "unknown upstream project: $project (petrus, petrus-engine, hamsterdan or petrus-sdks)" >&2
    exit 2
    ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
if [[ "$project" == petrus-sdks ]]; then
  upstream="$root/upstream/petrus"
  # uv syncs the project into this environment instead of its .venv.
  export UV_PROJECT_ENVIRONMENT="$root/dist-newstyle/upstream-python/petrus-sdks/.venv"
  python="$UV_PROJECT_ENVIRONMENT/bin/python"
else
  upstream="$root/upstream/$project"
  python="$upstream/.venv/bin/python"
fi

if [[ ! -f "$upstream/pyproject.toml" ]]; then
  echo "${upstream#"$root"/} is empty; run \`git submodule update --init ${upstream#"$root"/}\` in $root" >&2
  exit 1
fi

usable() {
  [[ -x "$python" ]] || return 1
  (cd "$upstream" && "$python" -I -c "
import sys
import $imports
sys.exit(0 if '%d.%d.%d' % sys.version_info[:3] == '$PYTHON_VERSION' else 1)
") >/dev/null 2>&1
}

# Several suites run in parallel (cabal test all) and each provisions the
# environment it needs on first use, so a sync is serialized by a lock: the
# first process to find the environment stale syncs it while the others wait
# and then find it usable. The lock is a directory (mkdir is atomic; macOS
# has no flock(1)) holding its owner's PID, under dist-newstyle/ (ignored by
# Git); a lock whose owner has exited is taken over.
lock="$root/dist-newstyle/upstream-python/$project.lock"

acquire_lock() {
  mkdir -p "$(dirname "$lock")"
  local waited=0 holder
  until mkdir "$lock" 2>/dev/null; do
    holder=$(cat "$lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      echo "upstream/$project: taking over the provisioning lock of exited process $holder" >&2
      rm -rf "$lock"
      continue
    fi
    if ((waited == 0)); then
      echo "upstream/$project: waiting for another process to finish provisioning it" >&2
    fi
    if ((waited >= 1800)); then
      echo "upstream/$project: still locked by process ${holder:-?} after ${waited}s ($lock)" >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo $$ >"$lock/pid"
  trap 'rm -rf "$lock"' EXIT
}

if ! usable; then
  acquire_lock
fi

if ! usable; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "the upstream/$project Python environment is missing or stale and \`uv\` is not on PATH; install uv, or run \`uv sync --frozen ${sync_args[*]+${sync_args[*]} }--python $PYTHON_VERSION\` in ${upstream#"$root"/}${UV_PROJECT_ENVIRONMENT:+ with UV_PROJECT_ENVIRONMENT=$UV_PROJECT_ENVIRONMENT}" >&2
    exit 1
  fi
  (cd "$upstream" && uv sync --frozen ${sync_args[@]+"${sync_args[@]}"} --python "$PYTHON_VERSION") >&2
  if ! usable; then
    echo "after uv sync, $python still does not run Python $PYTHON_VERSION with $imports importable" >&2
    exit 1
  fi
fi

echo "$python"
