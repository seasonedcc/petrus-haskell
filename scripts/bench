#!/usr/bin/env python3
"""Rerun the packages' benchmarks the way their results files document.

    scripts/bench                   # every package with a benchmark stanza, one at a time
    scripts/bench PKG [PKG ...]     # only these packages
    scripts/bench --list [PKG ...]  # print the rerun commands instead of running them
    scripts/bench --summary         # rewrite bench-results/summary.md from the results files
    scripts/bench --check           # every bench documents a rerun and the sources it measured;
                                    # summary.md is current
    scripts/bench --stale           # the results files whose package sources changed since measured
    scripts/bench --stamp PKG [FILE.md ...]
                                    # after a rerun: record that PKG's figures measure HEAD's sources
    scripts/bench --carry PKG [FILE.md ...] --reason "TEXT"
                                    # without a rerun: record that the figures still hold for HEAD's
                                    # sources, because the change since does not touch what they measure
    scripts/bench --smoke [PKG ...] # build every benchmark and run it once, quickly (CI's `full` run)

Each package's results (``packages/<pkg>/bench/RESULTS.md``) are curated by
hand: the workloads, the machine, how both sides were measured, and the
table. This script never writes them. Each one carries its rerun commands as a
``sh`` block right after the marker line

    <!-- scripts/bench: rerun -->

and ``scripts/bench PKG`` runs exactly that block, with bash (``-e -o
pipefail``) from the repository root, so the documented commands and the
rerun cannot drift apart. The output goes to the terminal and to
``bench-results/tmp/<pkg>.log`` (ignored by git); ``BENCH_TMP`` is set to an
empty scratch directory, ``bench-results/tmp/<pkg>/``. Then update the
results file by hand and run ``scripts/bench --summary``.

When the block or the package's benchmark sources mention
``PETRUS_TEST_POSTGRES`` and it is unset, the block runs under
``scripts/with-postgres``, which starts a throwaway server for it. Packages
run one after another, never in parallel.

Each results file also records which code its figures measured, in a marker

    <!-- scripts/bench: measured sources FINGERPRINT at COMMIT -->

FINGERPRINT hashes, as committed (git blob ids), the package's files but its
prose (``*.md``) and its tests (``test/``), the same files of every local
package it builds on (its .cabal file's stanzas other than test suites name
them, transitively; their benchmarks aside), ``cabal.project``, the freeze
file, the pinned ``upstream/`` commits and ``scripts/bench_timing.py``
(scripts/bench_results.py, ``sources_fingerprint``). COMMIT is where they
were. ``--check`` fails on a results file without the marker and lists, as
``STALE``, every results file whose fingerprint has changed since: its
figures measured other code and may no longer hold (a warning, so that a
code change does not have to wait for a quiet machine; ``scripts/bench-gate``
remeasures the headline rows on request, and
``scripts/check-parity`` names the components whose evidence is stale).
``--stale`` lists the same files. After rerunning a package and updating its
figures, ``--stamp PKG`` (or ``--stamp PKG results-x.md`` for one of several
files) records HEAD's fingerprint and regenerates the summary.

When the change since the measurement cannot touch the code paths the
figures measured (a bounds check on another path, a doc comment, a provider
the benchmark never runs), ``--carry PKG [FILE.md ...] --reason "TEXT"``
says so instead of a rerun. It keeps the measured marker as it is and adds,
after it and any earlier carry,

    <!-- scripts/bench: carried to FINGERPRINT at COMMIT: REASON -->

with HEAD's fingerprint and commit. The reason is required: it is the
claim that the change does not touch the measured paths, for a reviewer to
check. ``--check`` and ``--stale`` count a file as current when its latest
carry matches; ``bench-results/summary.md`` and ``scripts/check-parity``
show which files are carried, from which measured commit. A carry never
refreshes a figure: rerunning and ``--stamp`` does, and removes the carries.

``--smoke`` is not a measurement: it builds every benchmark and runs it once
(tasty-bench's ``--stdev Infinity``, or the sh block after a
``<!-- scripts/bench: smoke -->`` marker in the package's RESULTS.md, run
from the repository root with ``BENCH_BIN`` set to the built executable), so
that a benchmark cannot silently stop building or running. A `full` CI
dispatch does this.

A block typically runs ``scripts/bench-run <pkg> OPTIONS`` (the benchmark
executable, built once; options never enter cabal's configuration) and then
the Python twin once.
For the packages whose ``bench/python_bench.py`` names its rows like the
Haskell benchmarks, ``scripts/bench-compare <pkg> [N]`` interleaves N runs of
both sides and prints the comparison table their results files show.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Dict, List, Optional

ROOT = Path(__file__).resolve().parent.parent
TMP = ROOT / "bench-results" / "tmp"
MARKER = "<!-- scripts/bench: rerun -->"

sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "scripts"))
import bench_results  # noqa: E402


def environment() -> Dict[str, str]:
    env = dict(os.environ)
    extra = [str(Path.home() / ".ghcup" / "bin"), str(Path.home() / ".local" / "bin")]
    postgres_app = Path("/Applications/Postgres.app/Contents/Versions/17/bin")
    if postgres_app.is_dir():
        extra.append(str(postgres_app))
    env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
    return env


def benchmark_packages() -> List[str]:
    found = []
    for cabal in sorted(ROOT.glob("packages/*/*.cabal")):
        if re.search(r"^benchmark\s+\S+", cabal.read_text(), re.MULTILINE):
            found.append(cabal.parent.name)
    return found


def rerun_block(package: str) -> Optional[str]:
    """The sh block after the rerun marker in the package's RESULTS.md."""
    results = ROOT / "packages" / package / "bench" / "RESULTS.md"
    if not results.exists():
        return None
    lines = results.read_text(encoding="utf-8").splitlines()
    for index, line in enumerate(lines):
        if line.strip() != MARKER:
            continue
        rest = lines[index + 1 :]
        while rest and not rest[0].strip():
            rest = rest[1:]
        if not rest or not re.match(r"^```(sh|bash)\s*$", rest[0].strip()):
            return None
        body = []
        for code in rest[1:]:
            if code.strip() == "```":
                return "\n".join(body) + "\n"
            body.append(code)
        return None
    return None


def needs_postgres(package: str, block: str) -> bool:
    """Whether the block, or the package's benchmark sources, read PETRUS_TEST_POSTGRES."""
    if "PETRUS_TEST_POSTGRES" in block:
        return True
    bench = ROOT / "packages" / package / "bench"
    return any("PETRUS_TEST_POSTGRES" in source.read_text(encoding="utf-8", errors="replace") for source in bench.rglob("*.hs"))


def run(package: str) -> int:
    block = rerun_block(package)
    if block is None:
        print(f"{package}: bench/RESULTS.md has no `{MARKER}` sh block", file=sys.stderr)
        return 1
    scratch = TMP / package
    if scratch.exists():
        shutil.rmtree(scratch)
    scratch.mkdir(parents=True)
    env = environment()
    env["BENCH_TMP"] = str(scratch)
    argv = ["bash", "-e", "-o", "pipefail", "-c", block]
    if needs_postgres(package, block) and not env.get("PETRUS_TEST_POSTGRES"):
        argv = [str(ROOT / "scripts" / "with-postgres")] + argv
    log = TMP / f"{package}.log"
    print(f"==> {package}\n{block}", file=sys.stderr, flush=True)
    with log.open("w") as sink:
        sink.write(block + "\n")
        process = subprocess.Popen(argv, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        assert process.stdout is not None
        for line in process.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            sink.write(line)
        status = process.wait()
    shutil.rmtree(scratch, ignore_errors=True)
    print(f"<== {package}: exit {status}; log in {log.relative_to(ROOT)}", file=sys.stderr, flush=True)
    return status


def stale() -> List[str]:
    """The results files whose measured sources differ from the ones their
    figures measured (their `measured` marker)."""
    return [f"{path.relative_to(ROOT)} ({provenance})"
            for path, provenance in bench_results.stale_results().items()]


def check() -> int:
    status = 0
    for package in benchmark_packages():
        if rerun_block(package) is None:
            print(f"{package}: bench/RESULTS.md has no `{MARKER}` sh block", file=sys.stderr)
            status = 1
    for path in bench_results.results_files():
        if bench_results.measured(path) is None:
            print(f"{path.relative_to(ROOT)}: no `<!-- scripts/bench: measured sources ... -->` marker"
                  f" (after a rerun, `scripts/bench --stamp {path.parent.parent.name}`)", file=sys.stderr)
            status = 1
    if bench_results.main(["summary", "--check"]) != 0:
        status = 1
    if status == 0:
        print(f"{len(benchmark_packages())} benchmark packages document their rerun and the sources they measured;"
              " bench-results/summary.md is current")
    stale_files = bench_results.stale_results()
    changed = stale()
    for path in bench_results.results_files():
        carries = bench_results.carried(path)
        if carries and path not in stale_files:
            print(f"CARRIED {path.relative_to(ROOT)} ({bench_results.provenance(path)}): {carries[-1][2]}",
                  file=sys.stderr)
    for entry in changed:
        print(f"STALE {entry}: its package's sources or dependencies changed since it was measured", file=sys.stderr)
        if os.environ.get("GITHUB_ACTIONS"):
            print(f"::warning file={entry.split(' ')[0]}::benchmark results measured other code"
                  f" ({entry.split(' (', 1)[1].rstrip(')')}); rerun them and `scripts/bench --stamp`")
    if changed:
        print(f"warning: {len(changed)} of {len(bench_results.results_files())} results files are stale: their"
              " figures measured code that has changed since (rerun each and `scripts/bench --stamp PKG`, or"
              " `--carry` one whose change cannot touch the measured code paths)",
              file=sys.stderr)
    return status


def stamp(packages: List[str], files: List[str]) -> int:
    """Record, in each results file of the packages (or only FILES), that its
    figures measure the package's sources as committed in HEAD. Run it after
    rerunning a package's benchmarks and updating its figures, from a commit
    whose package sources are the ones measured. It removes any carry
    markers: the figures are measured again."""
    head = head_commit()
    for path in selected_results(packages, files):
        line = bench_results.measured_line(bench_results.sources_fingerprint(path.parent.parent.name), head)
        text = bench_results.CARRIED.sub("", path.read_text(encoding="utf-8"))
        if bench_results.MEASURED.search(text):
            text = bench_results.MEASURED.sub(line, text, count=1)
        else:
            first, _, rest = text.partition("\n")
            text = f"{first}\n\n{line}\n{rest}"
        path.write_text(text, encoding="utf-8")
        print(f"{path.relative_to(ROOT)}: {line}")
    return bench_results.main(["summary", "--write"])


def carry(packages: List[str], files: List[str], reason: str) -> int:
    """Record, in each results file of the packages (or only FILES), that its
    figures, measured at an older commit, still hold for the package's
    sources as committed in HEAD, for REASON: the change since does not
    touch the code paths they measure. The measured marker stays as it is;
    the carry line goes after it and after any earlier carry."""
    head = head_commit()
    status = 0
    for path in selected_results(packages, files):
        fingerprint = bench_results.sources_fingerprint(path.parent.parent.name)
        claimed = bench_results.current(path)
        if claimed is None:
            print(f"{path.relative_to(ROOT)}: no measured marker to carry (rerun it and `--stamp`)", file=sys.stderr)
            status = 1
            continue
        if claimed[0] == fingerprint:
            print(f"{path.relative_to(ROOT)}: already current ({bench_results.provenance(path)})")
            continue
        text = path.read_text(encoding="utf-8")
        last = (list(bench_results.CARRIED.finditer(text)) or [bench_results.MEASURED.search(text)])[-1]
        end = text.find("\n", last.start())
        end = len(text) if end < 0 else end
        line = bench_results.carried_line(fingerprint, head, reason)
        path.write_text(f"{text[:end]}\n{line}{text[end:]}", encoding="utf-8")
        print(f"{path.relative_to(ROOT)}: {line}")
    return status or bench_results.main(["summary", "--write"])


def head_commit() -> str:
    return subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, check=True, stdout=subprocess.PIPE,
                          text=True).stdout.strip()


def selected_results(packages: List[str], files: List[str]) -> List[Path]:
    """The results files of the packages, or only those named FILES."""
    return [path for path in bench_results.results_files()
            if path.parent.parent.name in packages and (not files or path.name in files)]


SMOKE = "<!-- scripts/bench: smoke -->"


def smoke_block(package: str) -> str:
    """The package's smoke run: the sh block after the smoke marker in its
    RESULTS.md, or else one quick pass of every tasty-bench row (each
    measured once: `--stdev Infinity`). It runs from the repository root with
    BENCH_BIN, the built benchmark executable, and cabal bench's environment."""
    results = ROOT / "packages" / package / "bench" / "RESULTS.md"
    lines = results.read_text(encoding="utf-8").splitlines() if results.exists() else []
    for index, line in enumerate(lines):
        if line.strip() == SMOKE:
            rest = [l for l in lines[index + 1:]]
            while rest and not rest[0].strip():
                rest = rest[1:]
            if rest and re.match(r"^```(sh|bash)\s*$", rest[0].strip()):
                body = []
                for code in rest[1:]:
                    if code.strip() == "```":
                        return "\n".join(body) + "\n"
                    body.append(code)
            raise SystemExit(f"{package}: the `{SMOKE}` marker is not followed by an sh block")
    return f'cd packages/{package} && "$BENCH_BIN" --stdev Infinity +RTS -M2G -RTS\n'


def bench_tools(cabal_text: str) -> List[str]:
    """The executables the benchmark stanza's build-tool-depends names, as
    cabal targets (`pkg:exe:name`)."""
    stanza = re.search(r"^benchmark\s+\S+\s*\n((?:[ \t].*\n|\s*\n)*)", cabal_text, re.MULTILINE)
    field = re.search(r"^\s*build-tool-depends:\s*((?:.*\n)(?:\s+,.*\n)*)", stanza.group(1) if stanza else "", re.MULTILINE)
    tools = []
    for item in (field.group(1).replace("\n", " ").split(",") if field else []):
        name = item.strip().split()[0] if item.strip() else ""
        if ":" in name:
            package, exe = name.split(":", 1)
            tools.append(f"{package}:exe:{exe}")
    return tools


def smoke(packages: List[str]) -> int:
    """Build every selected benchmark and run its smoke block: proof that the
    benchmarks still build and run to the end, not a measurement. In CI the
    PATH stays as it is: a PATH unlike the build job's would make cabal
    reconfigure every package."""
    env = dict(os.environ) if os.environ.get("CI") else environment()
    targets = {}
    tools = {}
    for package in packages:
        cabal_text = next((ROOT / "packages" / package).glob("*.cabal")).read_text()
        stanza = re.search(r"^benchmark\s+(\S+)", cabal_text, re.MULTILINE)
        targets[package] = f"{package}:bench:{stanza.group(1)}"
        tools[package] = bench_tools(cabal_text)
    subprocess.run(["cabal", "build", "-j", "--enable-benchmarks", *targets.values()], cwd=ROOT, env=env, check=True)

    def list_bin(target: str) -> str:
        return subprocess.run(["cabal", "list-bin", "-v0", "--enable-benchmarks", target], cwd=ROOT, env=env,
                              check=True, stdout=subprocess.PIPE, text=True).stdout.strip()

    failed = []
    for package, target in targets.items():
        binary = list_bin(target)
        # like cabal bench, the build-tool-depends executables come first on PATH
        tool_dirs = [str(Path(list_bin(tool)).parent) for tool in tools[package]]
        block = smoke_block(package)
        scratch = TMP / f"smoke-{package}"
        if scratch.exists():
            shutil.rmtree(scratch)
        scratch.mkdir(parents=True)
        run_env = dict(env, BENCH_BIN=binary, BENCH_TMP=str(scratch),
                       HASKELL_DIST_DIR=str(Path(binary).parent.parent.parent),
                       PATH=os.pathsep.join([*tool_dirs, env.get("PATH", "")]))
        run_env[f"{package.replace('-', '_')}_datadir"] = str(ROOT / "packages" / package) + "/."
        argv = ["bash", "-e", "-o", "pipefail", "-c", block]
        if needs_postgres(package, block) and not env.get("PETRUS_TEST_POSTGRES"):
            argv = [str(ROOT / "scripts" / "with-postgres")] + argv
        print(f"==> smoke {package}\n{block}", file=sys.stderr, flush=True)
        started = time.monotonic()
        status = subprocess.call(argv, cwd=ROOT, env=run_env)
        shutil.rmtree(scratch, ignore_errors=True)
        print(f"<== smoke {package}: exit {status} after {time.monotonic() - started:.0f} s", file=sys.stderr, flush=True)
        if status != 0:
            failed.append(package)
    if failed:
        print(f"benchmark smoke failed: {', '.join(failed)}", file=sys.stderr)
        return 1
    print(f"{len(targets)} benchmarks built and ran to the end")
    return 0


def main(argv: List[str]) -> int:
    reason = None
    if "--reason" in argv:
        at = argv.index("--reason")
        reason, argv = " ".join(argv[at + 1:at + 2]), argv[:at] + argv[at + 2:]
    flags = [a for a in argv if a.startswith("-")]
    packages = [a for a in argv if not a.startswith("-")]
    unknown_flags = [f for f in flags if f not in ("--list", "--summary", "--check", "--stale", "--stamp", "--carry",
                                                   "--smoke", "-h", "--help")]
    if unknown_flags or "-h" in flags or "--help" in flags:
        print(__doc__, file=sys.stderr)
        return 2 if unknown_flags else 0
    if "--summary" in flags:
        return bench_results.main(["summary", "--write"])
    if "--check" in flags:
        return check()
    if "--stale" in flags:
        changed = stale()
        for line in changed:
            print(line)
        print(f"{len(changed)} results files measured package sources that have changed since", file=sys.stderr)
        return 1 if changed else 0
    files = [p for p in packages if p.endswith(".md")]
    packages = [p for p in packages if not p.endswith(".md")]
    available = benchmark_packages()
    unknown = [p for p in packages if p not in available]
    if unknown:
        print(f"no benchmark stanza in: {', '.join(unknown)}", file=sys.stderr)
        return 2
    if "--stamp" in flags:
        if not packages:
            print("--stamp needs the packages whose figures were just measured", file=sys.stderr)
            return 2
        return stamp(packages, files)
    if "--carry" in flags:
        reason = " ".join((reason or "").split())
        if not packages or not reason or "-->" in reason:
            print('--carry needs the packages whose figures still hold and --reason "TEXT" (no `-->`): why the'
                  " change since they were measured does not touch the code paths they measure", file=sys.stderr)
            return 2
        return carry(packages, files, reason)
    selected = packages or available
    if "--smoke" in flags:
        TMP.mkdir(parents=True, exist_ok=True)
        return smoke(selected)
    if "--list" in flags:
        for package in selected:
            print(f"## {package}\n{rerun_block(package) or '(no rerun block)'}")
        return 0
    TMP.mkdir(parents=True, exist_ok=True)
    failed = [package for package in selected if run(package) != 0]
    if failed:
        print(f"failed: {', '.join(failed)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
