#!/bin/sh
# cabal's --test-wrapper in CI (scripts/ci-tests configure): runs a test
# binary with its arguments. When CI_TESTS_SELECTION names a selection file
# (scripts/ci-tests run-shard), the binary's suite part's hspec --match and
# --skip arguments are added first.
#
# hspec colours its output on GitHub Actions even into a pipe; the suite
# logs scripts/check-pending reads are plain text (it strips colour codes
# too, but a log no reader has to clean is the simpler contract).
HSPEC_COLOR=no
export HSPEC_COLOR
if [ -n "${CI_TESTS_SELECTION:-}" ]; then
  exec python3 "$(dirname "$0")/ci-tests" wrap "$CI_TESTS_SELECTION" "$@"
fi
exec "$@"
