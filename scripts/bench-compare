#!/usr/bin/env python3
"""Interleave a package's Haskell and Python benchmarks and tabulate them.

    scripts/bench-compare <package> [REPETITIONS] [options]   # default 2 repetitions

    --python SCRIPT     a Python twin in the package's bench/ directory
                        (repeatable; default python_bench.py)
    --upstream PROJECT  the pinned upstream project whose environment runs
                        the twins, from upstream/PROJECT (default petrus)
    --pattern PATTERN   only the tasty-bench rows this pattern selects (-p);
                        the table then lists only those rows
    --stdev PERCENT     tasty-bench's target relative deviation (default 5)
    --python-only REGEX only the twins' rows whose dotted names this regular
                        expression matches (PETRUS_BENCH_ONLY; the twins'
                        timing helpers honour it)
    --no-build          run the benchmark executable built already
    --twin COMMAND      a shell command, run from the repository root, that
                        runs the twin (repeatable; instead of --python), such
                        as the Python line of the package's rerun block
    --map HASKELL=TWIN  the twin's name for a Haskell row (repeatable), when
                        the automatic matching below does not find it
    --haskell-arg ARG   one more option for the benchmark executable
                        (repeatable), such as -j1

The twins' rows are read from what they print (`figures`): ``name,nanoseconds``
lines (scripts/bench_timing.py), ``NAME VALUE UNIT`` lines (``ns``, ``us``
or ``µs``, ``ms``, ``s``, optionally followed by ``/op``, ``per ...`` or a
parenthesised note) and ``NAME  key: VALUE UNIT  key: VALUE UNIT`` lines
(rows ``NAME.key``); other lines are ignored. A twin's row is matched to the
Haskell row with the same name, or, comparing names in lower case with
``/``, spaces and ``.`` alike, the same name or the Haskell name ending in
the twin's (``All.agents.keys/seal`` and ``keys/seal``). The package's
benchmark is built once with ``cabal build``; each repetition then runs its
executable directly, the way ``cabal bench <package>`` would (in the package
directory, with cabal's environment variables) but without cabal as the
parent process (tasty-bench ``--csv``, ``--stdev 5``,
``--time-mode wall``, ``+RTS -M2G``), and the twins (in the pinned upstream
environment from scripts/upstream-python) back to back, alternating which
goes first, and records the 1-minute load average around every run. Benchmarks that read ``PETRUS_TEST_POSTGRES`` get
a throwaway server from scripts/with-postgres when it is unset.

It prints a Markdown table: the median over repetitions of each row
(tasty-bench means for Haskell, or the ``twin NAME NANOSECONDS`` figure of a
row timed with the twins' own protocol; bench_timing medians for Python), their
ratio, the lowest per-repetition ratio, the repetitions Haskell was ahead in
(``k of n``), and every repetition's figures. The
same table is written to ``bench-results/tmp/<package>.compare.md``, and the
raw CSV files to ``bench-results/tmp/`` (ignored by git). It never writes a
package's RESULTS.md: those are curated by hand from runs like this one.

Every Haskell benchmark measures wall-clock time, as bench_timing.py does for
Python: most bench/Main.hs files set ``localOption WallTime``, and the
``--time-mode wall`` this script passes covers the ones that leave it to the
command line.
"""

from __future__ import annotations

import argparse
import csv
import os
import re
import statistics
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

ROOT = Path(__file__).resolve().parent.parent
TMP = ROOT / "bench-results" / "tmp"


def environment() -> Dict[str, str]:
    env = dict(os.environ)
    if env.get("CI"):
        # In CI the PATH stays as it is: a PATH unlike the build job's would
        # make cabal reconfigure every package (as in scripts/bench --smoke).
        return env
    extra = [str(Path.home() / ".ghcup" / "bin"), str(Path.home() / ".local" / "bin")]
    env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
    return env


def upstream_python(project: str) -> str:
    return subprocess.run(
        [str(ROOT / "scripts" / "upstream-python"), project],
        env=environment(),
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()


def benchmark_binary(package: str, build: bool = True) -> Tuple[Path, Dict[str, str]]:
    """Build the package's benchmark and return its executable and the
    environment ``cabal bench`` would run it with.

    The repetitions run the executable directly, as the Python twins run, not
    through ``cabal bench``: a benchmark started by cabal ran measurably
    slower (about 1% on petrus-posix's syscall-bound rows, in every pairing
    of an alternated check on 2026-10-11) than the same executable started
    directly, a cost the twins never pay. ``cabal bench`` runs the executable
    in the package directory with ``HASKELL_DIST_DIR`` and
    ``<package>_datadir`` set, and so does this script.
    """
    cabal_file = next((ROOT / "packages" / package).glob("*.cabal"))
    stanza = re.search(r"^benchmark\s+(\S+)", cabal_file.read_text(), re.MULTILINE)
    if stanza is None:
        raise SystemExit(f"{package} has no benchmark stanza")
    target = f"{package}:bench:{stanza.group(1)}"
    command = ["cabal", "build", "-j2", "--enable-benchmarks", target]
    if build:
        print("+ " + " ".join(shlex.quote(part) for part in command), file=sys.stderr, flush=True)
        subprocess.run(command, cwd=ROOT, env=environment(), check=True, stdout=sys.stderr)
    binary = Path(
        subprocess.run(
            ["cabal", "list-bin", "-v0", "--enable-benchmarks", target],
            cwd=ROOT,
            env=environment(),
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        ).stdout.strip()
    )
    env = environment()
    env["HASKELL_DIST_DIR"] = str(binary.parent.parent.parent)
    env[f"{package.replace('-', '_')}_datadir"] = str(ROOT / "packages" / package) + "/."
    return binary, env


def haskell(package: str, repetition: int, pattern: Optional[str], stdev: str, binary: Tuple[Path, Dict[str, str]],
            extra: Optional[List[str]] = None) -> Dict[str, float]:
    output = TMP / f"{package}.haskell.{repetition}.csv"
    if output.exists():
        output.unlink()
    selection = ["-p", pattern] if pattern else []
    options = selection + ["--csv", str(output), "--stdev", stdev, "--timeout", "300", "--time-mode", "wall"] + (extra or []) + ["+RTS", "-M2G", "-RTS"]
    executable, env = binary
    command = [str(executable)] + options
    print("+ " + " ".join(shlex.quote(part) for part in command), file=sys.stderr, flush=True)
    completed = subprocess.run(
        command,
        cwd=ROOT / "packages" / package,
        env=env,
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    sys.stderr.write(completed.stdout)
    # Rows timed with the twins' own protocol (Petrus.TestSupport.BenchTwin,
    # bench/Twin.hs in petrus-agenticus-runtime) are not tasty-bench
    # measurements, so the CSV leaves them out; they print "twin NAME
    # NANOSECONDS" instead. A custom harness prints NAME VALUE UNIT lines.
    results = figures(completed.stdout)
    if output.exists():
        with output.open(newline="") as stream:
            for row in csv.DictReader(stream):
                name = row["Name"]
                if name.startswith("All."):
                    name = name[len("All.") :]
                results[name] = float(row["Mean (ps)"]) / 1000.0
    return results


UNITS = {"ns": 1.0, "us": 1e3, "µs": 1e3, "μs": 1e3, "ms": 1e6, "s": 1e9}
VALUE = r"(\d+(?:\.\d+)?)\s*(ns|us|µs|μs|ms|s)\b"
HUMAN = re.compile(r"^\s*(\S.*?)\s*:?\s+" + VALUE + r"(?:/\w+| per \w+)?(?:\s+\(.*\))?\s*$")
KEYED = re.compile(r"([\w+]+):\s+" + VALUE)


def figures(text: str) -> Dict[str, float]:
    """Nanoseconds by row name from a benchmark's printed lines: ``name,ns``,
    ``twin NAME NS``, ``NAME VALUE UNIT ...`` and ``NAME  key: VALUE UNIT
    ...`` (rows ``NAME.key``). The first two win over the others."""
    loose: Dict[str, float] = {}
    exact: Dict[str, float] = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[0] == "twin":
            try:
                exact[parts[1]] = float(parts[2])
            except ValueError:
                pass
            continue
        row, comma, value = line.rpartition(",")
        if comma and row.strip() and re.fullmatch(r"\s*\d+(?:\.\d+)?\s*", value):
            exact[row.strip()] = float(value)
            continue
        keyed = KEYED.findall(line)
        if len(keyed) > 1:
            name = line[: line.index(keyed[0][0] + ":")].strip()
            for key, number, unit in keyed:
                loose[f"{name}.{key}"] = float(number) * UNITS[unit]
            continue
        match = HUMAN.match(line)
        if match and "±" not in line:  # not tasty-bench's own "1.64 μs ± 459 ns"
            loose[match.group(1).strip()] = float(match.group(2)) * UNITS[match.group(3)]
    loose.update(exact)
    return loose


def normal(name: str) -> str:
    name = name.lower()
    if name.startswith("all."):
        name = name[len("all."):]
    return re.sub(r"[/. ]+", ".", name).strip(".")


def matching(haskell_names: List[str], twin_names: List[str], explicit: Dict[str, str]) -> Dict[str, str]:
    """Twin row -> Haskell row: EXPLICIT (Haskell -> twin) first, then the
    same name, then the same normalized name, then a Haskell name whose
    normalized form ends with the twin's. Each Haskell row is matched once."""
    result: Dict[str, str] = {}
    taken = set()
    for h, t in explicit.items():
        h = h[len("All."):] if h.startswith("All.") else h
        result[t] = h
        taken.add(h)
    for t in twin_names:
        if t in result:
            continue
        if t in haskell_names and t not in taken:
            result[t] = t
            taken.add(t)
    for t in twin_names:
        if t in result:
            continue
        candidates = [h for h in haskell_names if h not in taken and normal(h) == normal(t)]
        if not candidates:
            candidates = [h for h in haskell_names if h not in taken and normal(h).endswith("." + normal(t))]
        if len(candidates) == 1:
            result[t] = candidates[0]
            taken.add(candidates[0])
    return result


def twin_commands(package: str, commands: List[str], repetition: int, only: Optional[str]) -> Dict[str, float]:
    outputs = []
    env = environment()
    if only:
        env["PETRUS_BENCH_ONLY"] = only
    for command in commands:
        print(f"+ {command}", file=sys.stderr, flush=True)
        completed = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", command], cwd=ROOT, env=env, check=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        outputs.append(completed.stdout)
    text = "".join(outputs)
    (TMP / f"{package}.python.{repetition}.csv").write_text(text)
    return figures(text)


def python(package: str, interpreter: str, upstream: str, scripts: List[str], repetition: int,
           only: Optional[str] = None) -> Dict[str, float]:
    results = {}
    outputs = []
    for name in scripts:
        script = ROOT / "packages" / package / "bench" / name
        print(f"+ {interpreter} -I -B {script.relative_to(ROOT)}", file=sys.stderr, flush=True)
        env = environment()
        if only:
            env["PETRUS_BENCH_ONLY"] = only
        completed = subprocess.run(
            [interpreter, "-I", "-B", str(script)],
            cwd=ROOT / "upstream" / upstream,
            env=env,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        outputs.append(completed.stdout)
        results.update(figures(completed.stdout))
    (TMP / f"{package}.python.{repetition}.csv").write_text("".join(outputs))
    return results


def human(ns: Optional[float]) -> str:
    if ns is None:
        return "—"
    for unit, scale in (("s", 1e9), ("ms", 1e6), ("µs", 1e3)):
        if ns >= scale:
            return f"{ns / scale:.3g} {unit}"
    return f"{ns:.3g} ns"


def main() -> int:
    arguments = sys.argv[1:]
    if not arguments or arguments[0].startswith("-"):
        print(__doc__, file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(usage=__doc__)
    parser.add_argument("package")
    parser.add_argument("repetitions", nargs="?", type=int, default=2)
    parser.add_argument("--python", action="append", dest="scripts")
    parser.add_argument("--upstream", default="petrus")
    parser.add_argument("--pattern")
    parser.add_argument("--stdev", default="5")
    parser.add_argument("--python-only", dest="only")
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--twin", action="append", dest="twins")
    parser.add_argument("--map", action="append", default=[])
    parser.add_argument("--haskell-arg", action="append", dest="haskell_args", default=[])
    options = parser.parse_args(arguments)
    explicit = dict(m.split("=", 1) for m in options.map)
    package = options.package
    repetitions = options.repetitions
    scripts = options.scripts or ["python_bench.py"]
    sources = " ".join(h.read_text() for h in (ROOT / "packages" / package / "bench").rglob("*.hs"))
    for name in ([] if options.twins else scripts):
        if not (ROOT / "packages" / package / "bench" / name).exists():
            print(f"{package} has no bench/{name}", file=sys.stderr)
            return 2
    if "PETRUS_TEST_POSTGRES" in sources + " ".join(options.twins or []) and not os.environ.get("PETRUS_TEST_POSTGRES"):
        # Re-run under a throwaway server; scripts/with-postgres stops it.
        return subprocess.call([str(ROOT / "scripts" / "with-postgres"), sys.executable, __file__, *arguments])
    TMP.mkdir(parents=True, exist_ok=True)
    interpreter = None if options.twins else upstream_python(options.upstream)
    binary = benchmark_binary(package, build=not options.no_build)

    def theirs_now(repetition: int) -> Dict[str, float]:
        if options.twins:
            return twin_commands(package, options.twins, repetition, options.only)
        return python(package, interpreter, options.upstream, scripts, repetition, options.only)

    def ours_now(repetition: int) -> Dict[str, float]:
        return haskell(package, repetition, options.pattern, options.stdev, binary, options.haskell_args)

    runs: List[Tuple[Dict[str, float], Dict[str, float]]] = []
    loads: List[float] = []
    for repetition in range(1, repetitions + 1):
        loads.append(os.getloadavg()[0])
        if repetition % 2:
            ours = ours_now(repetition)
            loads.append(os.getloadavg()[0])
            theirs = theirs_now(repetition)
        else:
            theirs = theirs_now(repetition)
            loads.append(os.getloadavg()[0])
            ours = ours_now(repetition)
        loads.append(os.getloadavg()[0])
        names_of = matching(list(ours), list(theirs), explicit)
        theirs = {names_of.get(name, name): value for name, value in theirs.items()}
        runs.append((ours, theirs))
        print(f"repetition {repetition} done, load average {loads[-3]:.2f} / {loads[-2]:.2f} / {loads[-1]:.2f}", file=sys.stderr)
    lines = [
        f"{package}: {repetitions} interleaved repetitions; load average (1 min) {min(loads):.2f} to {max(loads):.2f}.",
        "",
        "| Benchmark | Haskell | Python | Python / Haskell | Lowest per repetition | Haskell ahead | Haskell per repetition | Python per repetition |",
        "|---|---:|---:|---:|---:|---:|---|---|",
    ]
    names = list(runs[0][0])
    if not options.pattern:
        names += [name for name in runs[0][1] if name not in runs[0][0]]
    for name in names:
        ours = [run[0][name] for run in runs if name in run[0]]
        theirs = [run[1][name] for run in runs if name in run[1]]
        h = statistics.median(ours) if ours else None
        p = statistics.median(theirs) if theirs else None
        ratio = f"{p / h:.2f}×" if h and p else "—"
        paired = [run[1][name] / run[0][name] for run in runs if name in run[0] and name in run[1]]
        lowest = f"{min(paired):.2f}×" if paired else "—"
        ahead = f"{sum(1 for x in paired if x > 1)} of {len(paired)}" if paired else "—"
        lines.append(
            f"| `{name}` | {human(h)} | {human(p)} | {ratio} | {lowest} | {ahead} | "
            f"{', '.join(human(x) for x in ours)} | {', '.join(human(x) for x in theirs)} |"
        )
    text = "\n".join(lines) + "\n"
    (TMP / f"{package}.compare.md").write_text(text)
    sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
