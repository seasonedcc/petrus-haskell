#!/usr/bin/env bash
# Fail if PARITY.md claims "at parity" for a component
#   - without evidence, or
#   - while a benchmark results file its evidence cites has a row where
#     Haskell is slower than Python (a ratio below 1.0×); see
#     scripts/bench_results.py for how ratios are read and how a shared
#     results file attributes its slower rows to other components;
#   - or if an upstream test count a parity ledger cites ("all 11 `test_x.py`
#     tests (14 cases)", a Functions or Cases column) differs from
#     docs/upstream-test-counts.json, the counts pytest collected at the
#     pinned upstream commits, or is in a form it cannot read
#     (scripts/upstream-test-counts);
#   - or if a document states a Haskell example count, which would go stale
#     (scripts/lint-example-counts: `cabal test` and CI report those);
#   - or if a parity or divergence document restates a benchmark ratio,
#     which would go stale with the next rerun (scripts/lint-bench-figures:
#     the results files and bench-results/summary.md hold the figures).
# It warns (STALE evidence) about components whose cited results measured
# code that has changed since.
set -euo pipefail
cd "$(dirname "$0")/.."
bad=$(awk -F'|' '/^\|/ && $5 ~ /at parity/ && $6 ~ /^ *$/ {print $2}' PARITY.md)
if [[ -n "$bad" ]]; then
  echo "components marked at parity without evidence:" >&2
  echo "$bad" >&2
  exit 1
fi
# Every package a row names carries its DIVERGENCES.md (README: every
# intentional divergence is documented next to the package), "None" if so.
missing=$(awk -F'|' '/^\|/ {print $4}' PARITY.md | grep -o '`[a-z0-9-]*`' | tr -d '`' | sort -u |
  while read -r package; do
    if [[ -d "packages/$package" && ! -f "packages/$package/DIVERGENCES.md" ]]; then echo "$package"; fi
  done)
if [[ -n "$missing" ]]; then
  echo "packages named in PARITY.md without a DIVERGENCES.md:" >&2
  echo "$missing" >&2
  exit 1
fi
python3 -B scripts/bench_results.py check-parity
python3 -B scripts/upstream-test-counts --check
python3 -B scripts/lint-example-counts
python3 -B scripts/lint-bench-figures
total=$(awk -F'|' '/^\|/ && $5 ~ /^ *(not started|in progress|at parity)/ {n++} END {print n+0}' PARITY.md)
done_=$(awk -F'|' '/^\|/ && $5 ~ /^ *at parity/ {n++} END {print n+0}' PARITY.md)
echo "$done_ of $total components at parity"
