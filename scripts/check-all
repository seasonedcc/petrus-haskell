#!/usr/bin/env bash
# Rebuild and verify everything from a clean checkout: build, unit tests,
# conformance, interop against the pinned Python upstream, the committed
# corpora regenerated from it, the benchmark bookkeeping, and the parity
# table. CI (.github/workflows/ci.yml) runs the same steps, plus --viewer,
# spread over several runners; docs/reproducing.md, "Continuous
# integration", maps each CI job to its step here.
#
#   scripts/check-all            # everything except benchmarks and the viewer suites
#   scripts/check-all -j2        # limit cabal's parallelism (passed to cabal)
#   scripts/check-all --viewer   # also the upstream petrus-viewer suites against the
#                                # Haskell backend (scripts/interop --viewer; needs
#                                # Node 22, pnpm install and pnpm build in
#                                # upstream/petrus-viewer, and Playwright's Chromium)
#   scripts/check-all --bench    # also rerun every benchmark against Python (slow)
#
# Every test binary runs with a 2 GiB heap cap (+RTS -M2G -RTS), as locally.
# Any build or test failure fails the script; cabal keeps going past a failing
# suite so one run reports every failure. When PETRUS_TEST_POSTGRES is unset,
# the tests run against a throwaway PostgreSQL server (scripts/with-postgres:
# initdb/pg_ctl or Docker), so the PostgreSQL suites run instead of going
# pending; with neither available the script stops and says so.
set -euo pipefail
cd "$(dirname "$0")/.."
# ghcup's toolchain, and uv's default install location (the interop suites
# provision the pinned Python upstream with uv).
export PATH="$HOME/.ghcup/bin:$HOME/.local/bin:$PATH"

run_bench=0
run_viewer=0
cabal_flags=()
for arg in "$@"; do
  case "$arg" in
    --bench) run_bench=1 ;;
    --viewer) run_viewer=1 ;;
    -j*) cabal_flags+=("$arg") ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

step() { printf '\n==> %s\n' "$*"; }

step "Upstream pins"
scripts/check-pins

step "No silent skips on a missing Python reference"
scripts/lint-skips

step "Hamsterdan import boundaries (upstream tests/test_architecture.py)"
scripts/lint-hamsterdan-architecture

step "Upstream Python environment"
if ! command -v uv >/dev/null 2>&1; then
  echo "uv is not on PATH; the interop suites need it to provision the upstream Python environments" >&2
  exit 1
fi
# Provision every reference once, before the suites run in parallel and
# each would (scripts/upstream-python also serializes a lazy sync with a
# lock, so a suite that provisions on first use is safe too).
for project in petrus petrus-engine hamsterdan petrus-sdks; do
  python=$(scripts/upstream-python "$project")
  echo "upstream/$project: $("$python" -I -c 'import sys; print(sys.version)')"
done

# In CI the PostgreSQL and Docker suites must run, never skip as pending.
if [[ -n "${CI:-}" && -z "${PETRUS_TEST_POSTGRES:-}" ]]; then
  echo "CI is set but PETRUS_TEST_POSTGRES is not: the PostgreSQL suites would be skipped" >&2
  exit 1
fi
if [[ -n "${CI:-}" && "${PETRUS_TEST_DOCKER:-}" != 1 ]]; then
  echo "CI is set but PETRUS_TEST_DOCKER is not 1: the Docker suites would be skipped" >&2
  exit 1
fi

step "Build (all packages, -Werror)"
cabal build all ${cabal_flags[@]+"${cabal_flags[@]}"}

step "Interop selection (scripts/interop patterns still select their groups)"
scripts/interop --check ${cabal_flags[@]+"${cabal_flags[@]}"}

step "Tests (unit, conformance, interop)"
# Each suite's output also goes to its own log, for the pending check below.
test_logs=$(mktemp -d)
trap 'rm -rf "$test_logs"' EXIT
scripts/with-postgres cabal test all ${cabal_flags[@]+"${cabal_flags[@]}"} --keep-going \
  --test-show-details=streaming --test-log="$test_logs/\$pkgid-\$test-suite.log" \
  --test-options='+RTS -M2G -RTS'

step "No pending examples (a missing tool or server fails; only the opt-ins in scripts/check-pending may pend)"
scripts/check-pending "$test_logs"

step "Committed corpora (every generator rerun against the pinned references)"
scripts/check-corpora

if [[ "$run_viewer" == 1 ]]; then
  step "The upstream petrus-viewer suites against the Haskell backend"
  scripts/interop --viewer petrus-viewer-server ${cabal_flags[@]+"${cabal_flags[@]}"}
  step "The MCP golden transcript (re-recorded through the upstream Node MCP server)"
  node packages/petrus-viewer-server/test/record-mcp-transcript.mjs --check
fi

if [[ "$run_bench" == 1 ]]; then
  step "Benchmarks"
  scripts/bench
fi

step "Benchmark bookkeeping (rerun blocks, measured sources, bench-results/summary.md)"
scripts/bench --check

step "Parity table"
scripts/check-parity

step "Runtime test ledgers (every in-scope upstream test accounted for)"
python3 packages/petrus-engine/scripts/parity_check.py
