#!/usr/bin/env python3
"""Spread CI's test suites over its test shards, and run them.

    scripts/ci-tests check-steps             # every scripts/check-all step is a CI step
    scripts/ci-tests check-parts             # the split suites' parts select each example once (needs the build)
    scripts/ci-tests plan --out PLAN [--max-shards N] [--target SECONDS]
                                             # every test suite, spread over the shards
    scripts/ci-tests run-shard PLAN NAME [--logs DIR]
                                             # cabal test the shard's suites (no pending example but the
                                             # opt-ins); each suite's output to DIR
    scripts/ci-tests configure               # write CI's cabal.project.local (its test flags; CI only)
    scripts/ci-tests wrap SELECTION BIN ...  # (scripts/ci-test-wrapper, cabal's --test-wrapper)
    scripts/ci-tests run-viewer              # scripts/interop --viewer petrus-viewer-server

`scripts/check-all` runs every suite on one machine; this script is CI's way
of spreading the same `cabal test` runs over several runners. Every CI run
runs every suite: `plan` puts every test suite of cabal's plan
(dist-newstyle/cache/plan.json) into a shard, and CI's viewer job runs the
upstream petrus-viewer suites (`run-viewer`).
"""

from __future__ import annotations

import json
import math
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Set

ROOT = Path(__file__).resolve().parent.parent
TIMES = ROOT / ".github" / "ci" / "test-times.json"


def test_suites() -> Dict[str, str]:
    """Every test suite of the local packages, by name, with its package, as
    cabal's plan (dist-newstyle/cache/plan.json) records them."""
    plan_path = ROOT / "dist-newstyle" / "cache" / "plan.json"
    if not plan_path.exists():
        raise SystemExit("dist-newstyle/cache/plan.json is missing: run `cabal build all --dry-run` first")
    plan_doc = json.loads(plan_path.read_text())
    packages: Set[str] = set()
    suites: Dict[str, List[str]] = {}
    for unit in plan_doc["install-plan"]:
        if unit.get("style") != "local":
            continue
        name = unit["pkg-name"]
        packages.add(name)
        components = unit.get("components") or {unit.get("component-name", "lib"): unit}
        for component_name in components:
            if component_name.startswith("test:"):
                suites.setdefault(name, []).append(component_name[len("test:"):])
    suites = {k: sorted(set(v)) for k, v in suites.items()}
    check_plan_is_current(packages, suites)
    return {suite: package for package, names in suites.items() for suite in names}


def check_plan_is_current(packages: Set[str], suites: Dict[str, List[str]]) -> None:
    """The plan must describe the checked-out package descriptions: every
    packages/*/*.cabal is a local package of it, with exactly the test
    suites that file declares. A stale plan.json (one cabal did not rewrite
    after a .cabal file changed) would otherwise leave a new suite unplanned
    and unrun while CI passes."""
    declared: Dict[str, List[str]] = {}
    for cabal_file in sorted((ROOT / "packages").glob("*/*.cabal")):
        text = cabal_file.read_text()
        name = re.search(r"^name:\s*(\S+)", text, re.M | re.I)
        tests = re.findall(r"^test-suite\s+(\S+)", text, re.M | re.I)
        declared[name.group(1) if name else cabal_file.stem] = sorted(set(tests))
    problems = []
    for package in sorted(set(declared) | packages):
        if package not in packages:
            problems.append(f"{package}: in packages/ but not in the plan")
        elif package not in declared:
            problems.append(f"{package}: in the plan but has no packages/*/*.cabal")
        elif declared[package] != suites.get(package, []):
            problems.append(f"{package}: its .cabal declares test suites {declared[package]}, the plan has {suites.get(package, [])}")
    if problems:
        raise SystemExit("dist-newstyle/cache/plan.json does not match the package descriptions"
                         " (rerun `cabal build all --dry-run`):\n  " + "\n  ".join(problems))


# ---------------------------------------------------------------------------
# Units and shards
#
# A unit is what one shard runs of one suite: the whole suite, or one part
# of it. .github/ci/test-times.json can split a long suite into parts, each a
# list of hspec --match patterns; the suite's remaining part ("rest") skips
# every pattern of the other parts. So every example belongs to a part that
# matches it or to the rest, and runs at least once: a pattern that selects
# nothing leaves its examples to the rest. A suite counts as passed only when
# all its units passed.


def load_times() -> dict:
    try:
        return json.loads(TIMES.read_text())
    except (OSError, ValueError):
        return {}


def units_of(suite: str, times: dict) -> List[dict]:
    parts = times.get("parts", {}).get(suite)
    seconds = times.get("seconds", {})
    if not parts:
        return [{"id": suite, "suite": suite, "args": [], "seconds": float(seconds.get(suite, 60))}]
    units = []
    every = []
    for name, part in parts.items():
        patterns = part["match"]
        every += patterns
        args = [a for p in patterns for a in ("--match", p)]
        units.append({"id": f"{suite}#{name}", "suite": suite, "args": args, "seconds": float(part["seconds"])})
    rest = float(seconds.get(suite, 60)) - sum(u["seconds"] for u in units)
    units.append({"id": f"{suite}#rest", "suite": suite, "args": [a for p in every for a in ("--skip", p)], "seconds": max(rest, 1.0)})
    return units


def check_parts() -> int:
    """The parts of every split suite, as hspec dry runs of the built test
    binaries: each part selects at least one example, and the parts plus the
    rest select the suite's examples exactly once each (their counts add up
    to the suite's: an overlap would add more)."""
    times = load_times()
    bad = 0
    for suite in sorted(times.get("parts", {})):
        package = suite.removesuffix("-test")
        binary = subprocess.run(["cabal", "list-bin", "-v0", f"{package}:test:{suite}"], cwd=ROOT, check=True,
                                capture_output=True, text=True).stdout.strip()

        def selected(args: List[str]) -> int:
            out = subprocess.run([binary, "--dry-run", *args], cwd=ROOT / "packages" / package,
                                 capture_output=True).stdout
            found = SUMMARY.findall(out)
            return int(found[-1][0]) if found else -1

        total = selected([])
        counts = {u["id"]: selected(u["args"]) for u in units_of(suite, times)}
        for unit, n in counts.items():
            print(f"{unit}: {n} examples")
            if n < 1:
                print(f"ci-tests: {unit} selects no example", file=sys.stderr)
                bad += 1
        if sum(counts.values()) != total:
            print(f"ci-tests: the parts of {suite} select {sum(counts.values())} examples, the suite has {total}",
                  file=sys.stderr)
            bad += 1
        else:
            print(f"{suite}: {len(counts)} parts select its {total} examples once each")
    return 1 if bad else 0


def shard(units: List[dict], max_shards: int, target: float) -> List[dict]:
    """Longest processing time first, over as few shards as keep each near
    the target, at most max_shards; two units of one suite never share a shard
    (each shard gives a suite one selection)."""
    if not units:
        return []
    total = sum(u["seconds"] for u in units)
    per_suite: Dict[str, int] = {}
    for u in units:
        per_suite[u["suite"]] = per_suite.get(u["suite"], 0) + 1
    widest = max(per_suite.values())
    count = min(len(units), max(min(max_shards, math.ceil(total / target)), widest, 1))
    bins: List[List[dict]] = [[] for _ in range(count)]
    loads = [0.0] * count
    for unit in sorted(units, key=lambda u: (-u["seconds"], u["id"])):
        candidates = [i for i in range(count) if all(other["suite"] != unit["suite"] for other in bins[i])]
        i = min(candidates, key=lambda j: loads[j])
        bins[i].append(unit)
        loads[i] += unit["seconds"]
    shards = []
    for i, (members, load) in enumerate(sorted(zip(bins, loads), key=lambda x: -x[1])):
        members = sorted(members, key=lambda u: u["id"])
        shards.append({
            "name": str(i + 1),
            "units": [u["id"] for u in members],
            "suites": " ".join(u["id"] for u in members),
            "estimate": round(load),
        })
    return shards


def plan(args: List[str]) -> int:
    max_shards = int(args[args.index("--max-shards") + 1]) if "--max-shards" in args else 10
    target = float(args[args.index("--target") + 1]) if "--target" in args else 120.0
    out = Path(args[args.index("--out") + 1]) if "--out" in args else None

    suites = test_suites()
    times = load_times()
    units = [u for s in sorted(suites) for u in units_of(s, times)]
    shards = shard(units, max_shards, target)

    print(f"{len(suites)} suites in {len(shards)} shards\n")
    for s in shards:
        print(f"  shard {s['name']} (~{s['estimate']} s): {s['suites']}")

    document = {
        "packages": suites,
        "units": {u["id"]: u for u in units},
        "shards": shards,
    }
    if out:
        out.write_text(json.dumps(document, indent=1, sort_keys=True))
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as f:
            f.write(f"### Test plan\n\n{len(suites)} suites in {len(shards)} shards, plus the viewer job.\n\n")
            f.write("| shard | estimate (s) | suites |\n|---|---|---|\n")
            for s in shards:
                f.write(f"| {s['name']} | {s['estimate']} | {s['suites']} |\n")
    return 0

# ---------------------------------------------------------------------------
# Running a shard


def suite_logs(package: str, suite: str) -> List[Path]:
    return list((ROOT / "dist-newstyle" / "build").glob(f"*/*/{package}-*/t/{suite}/test/*-{suite}.log"))


def passed(package: str, suite: str) -> bool:
    logs = suite_logs(package, suite)
    text = "\n".join(log.read_text(errors="replace") for log in logs)
    return bool(logs) and f"Test suite {suite}: PASS" in text and f"Test suite {suite}: FAIL" not in text


def no_pending(log: Path, scratch: Path) -> bool:
    """scripts/check-pending on this one suite's output: no pending example
    but the declared opt-ins."""
    if not log.is_file():
        return False
    alone = Path(tempfile.mkdtemp(prefix="pending-", dir=scratch))
    shutil.copy(log, alone / log.name)
    return subprocess.call([str(ROOT / "scripts" / "check-pending"), str(alone)], cwd=ROOT) == 0


SUMMARY = re.compile(rb"(\d+) examples?, (\d+) failures?(?:, (\d+) pending)?")


def counts(directory: Path, suite: str) -> Dict[str, int]:
    """The suite's hspec summary (examples, failures, pending), as the
    wrapper recorded it in DIRECTORY (with --test-show-details=direct the
    suite's log leaves it out)."""
    recorded = directory / f"{suite}.json"
    return json.loads(recorded.read_text()) if recorded.is_file() else {}


def report(outcome: Dict[str, bool], tallies: Dict[str, Dict[str, int]]) -> None:
    """Each unit's verdict, with its hspec summary when the wrapper recorded one."""
    for u, ok in sorted(outcome.items()):
        tally = tallies.get(u, {})
        detail = f" ({tally['examples']} examples, {tally['pending']} pending)" if tally else ""
        print(f"{u}: {'passed' if ok else 'FAILED'}{detail}")


def run_shard(args: List[str]) -> int:
    """PLAN NAME: `cabal test` this shard's suites (in parallel, as
    scripts/check-all does), each restricted to its part: cabal runs every
    test binary through scripts/ci-test-wrapper (--test-wrapper), which adds
    the part's hspec --match/--skip arguments from CI_TESTS_SELECTION
    (hspec takes no --match from a .hspec file or HSPEC_OPTIONS, and
    --test-options would apply to every suite of the invocation).

    With --logs DIR, each suite's output is kept as DIR/SUITE.log. A suite
    passes only when its binary passed and scripts/check-pending finds no
    pending example in its output but the declared opt-ins, as in
    scripts/check-all; CI's next step runs scripts/check-pending over DIR
    too."""
    plan_file, name = args[0], args[1]
    logs = Path(args[args.index("--logs") + 1]) if "--logs" in args else None
    # As scripts/check-all: in CI the PostgreSQL and Docker suites must run
    # (the Docker ones would otherwise pend as a declared opt-in).
    if os.environ.get("CI") and (not os.environ.get("PETRUS_TEST_POSTGRES") or os.environ.get("PETRUS_TEST_DOCKER") != "1"):
        print("ci-tests: CI is set but PETRUS_TEST_POSTGRES is unset or PETRUS_TEST_DOCKER is not 1:"
              " the PostgreSQL or Docker suites would be skipped", file=sys.stderr)
        return 2
    document = json.loads(Path(plan_file).read_text())
    shard_doc = next(s for s in document["shards"] if s["name"] == name)
    units = [document["units"][u] for u in shard_doc["units"]]
    selection: Dict[str, List[str]] = {}
    targets = []
    for unit in units:
        package = document["packages"][unit["suite"]]
        targets.append(f"{package}:test:{unit['suite']}")
        for log in suite_logs(package, unit["suite"]):
            log.unlink()
        if unit["args"]:
            selection[unit["suite"]] = unit["args"]
            print(f"{unit['id']}: {' '.join(shlex.quote(a) for a in unit['args'])}")
    scratch = Path(tempfile.mkdtemp(prefix="ci-tests-", dir=os.environ.get("RUNNER_TEMP")))
    logs = logs or scratch / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    for unit in units:
        (logs / f"{unit['suite']}.log").unlink(missing_ok=True)
    selection_file = scratch / "selection.json"
    selection_file.write_text(json.dumps({"args": selection, "counts": str(scratch), "logs": str(logs)}))
    jobs = os.environ.get("CI_TEST_JOBS", "-j")
    if not PROJECT_LOCAL.exists() or PROJECT_LOCAL.read_text() != project_config():
        print("ci-tests: run `scripts/ci-tests configure` first (CI's test flags come from cabal.project.local)",
              file=sys.stderr)
        return 2
    command = ["cabal", "test", jobs, *targets, "--keep-going"]
    print("$ " + " ".join(shlex.quote(c) for c in command), flush=True)
    try:
        status = subprocess.call(command, cwd=ROOT, env={**os.environ, "CI_TESTS_SELECTION": str(selection_file)})
        tallies = {u["id"]: counts(scratch, u["suite"]) for u in units}
        outcome = {u["id"]: passed(document["packages"][u["suite"]], u["suite"])
                   and no_pending(logs / f"{u['suite']}.log", scratch) for u in units}
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    report(outcome, tallies)
    return status if status != 0 else (0 if all(outcome.values()) else 1)


PROJECT_LOCAL = ROOT / "cabal.project.local"
PROJECT_LOCAL_HEADER = "-- Written by scripts/ci-tests configure"


def project_config() -> str:
    """CI's cabal.project.local: the test flags of every cabal command in
    every CI job. cabal records them in each local package's configuration,
    and a flag given on one command line but not another makes cabal
    reconfigure (and relink) every package; from the project file, `cabal
    build` in the build job, `cabal test` in the test jobs and
    scripts/interop's builds in the checks and viewer jobs all share one
    configuration and rebuild nothing. The wrapper (scripts/ci-test-wrapper)
    runs a test binary unchanged unless CI_TESTS_SELECTION names a
    selection file. Every test binary runs with a 2 GiB heap cap, as in
    scripts/check-all."""
    return (f"{PROJECT_LOCAL_HEADER} (CI only; see that script).\n"
            "test-show-details: direct\n"
            f"test-wrapper: {ROOT / 'scripts' / 'ci-test-wrapper'}\n"
            "test-options: +RTS -M2G -RTS\n")


def configure() -> int:
    """Write CI's cabal.project.local (project_config). It refuses to replace
    a cabal.project.local that it did not write."""
    if PROJECT_LOCAL.exists() and not PROJECT_LOCAL.read_text().startswith(PROJECT_LOCAL_HEADER):
        print(f"ci-tests: {PROJECT_LOCAL} exists and is not CI's; not replacing it", file=sys.stderr)
        return 1
    PROJECT_LOCAL.write_text(project_config())
    print(f"ci-tests: wrote {PROJECT_LOCAL.name}:\n{project_config()}", end="")
    return 0


def wrap(args: List[str]) -> int:
    """SELECTION BINARY ARGS...: run a test binary (cabal's --test-wrapper)
    with its suite's part selection from SELECTION added to its arguments,
    pass its output through, keep it as SELECTION's logs directory's
    SUITE.log (for scripts/check-pending), and record its hspec summary in
    SELECTION's counts directory (a shard runs at most one part of a
    suite)."""
    selection = json.loads(Path(args[0]).read_text())
    binary, rest = args[1], args[2:]
    suite = Path(binary).name
    extra = selection["args"].get(suite, [])
    if extra:
        print(f"{suite}: {' '.join(shlex.quote(a) for a in extra)}", file=sys.stderr, flush=True)
    child = subprocess.Popen([binary, *extra, *rest], stdout=subprocess.PIPE)
    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, lambda s, _frame: child.send_signal(s))
    tail = b""
    with open(Path(selection["logs"]) / f"{suite}.log", "wb") as log:
        while True:
            chunk = os.read(child.stdout.fileno(), 65536)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            log.write(chunk)
            tail = (tail + chunk)[-65536:]
    code = child.wait()
    found = SUMMARY.findall(tail)
    if found:
        examples, failures, pending = found[-1]
        record = {"examples": int(examples), "failures": int(failures), "pending": int(pending or 0)}
        (Path(selection["counts"]) / f"{suite}.json").write_text(json.dumps(record))
    return code if code >= 0 else 128 - code


# The upstream petrus-viewer suites (packages/petrus-viewer-server/
# upstream-tests/run.mjs), in groups that run side by side: wire waits out
# quiet windows, the browser suites wait on Chromium, and neither uses much
# CPU. Together they are every suite run.mjs knows.
VIEWER_GROUPS = [
    ["wire"],
    ["playwright", "live"],
    ["relay", "endpoints", "url-cache", "cli", "mcp", "mcp-haskell-relay", "mcp-node-haskell-relay", "collab", "protocol", "differential", "history"],
]


def run_viewer() -> int:
    """What scripts/interop --viewer petrus-viewer-server runs: the
    package's interop group, then every upstream petrus-viewer suite against
    the Haskell backend (in VIEWER_GROUPS, side by side, on one build of the
    executables)."""
    status = subprocess.call([str(ROOT / "scripts" / "interop"), "-j", "petrus-viewer-server"], cwd=ROOT)
    run_mjs = ROOT / "packages" / "petrus-viewer-server" / "upstream-tests" / "run.mjs"
    block = re.search(r"^const SUITES = \{\n(.*?)^\};", run_mjs.read_text(), re.S | re.M)
    listed = sorted(re.findall(r'^  "?([a-z-]+)"?: \{', block.group(1), re.M)) if block else []
    if listed != sorted(s for g in VIEWER_GROUPS for s in g):
        print(f"ci-tests: VIEWER_GROUPS does not name exactly run.mjs's suites ({', '.join(listed)})", file=sys.stderr)
        return 1
    scratch = Path(tempfile.mkdtemp(prefix="ci-viewer-", dir=os.environ.get("RUNNER_TEMP")))
    bins = scratch / "bin"
    bins.mkdir()
    test = "petrus-viewer-server:test:petrus-viewer-server-test"
    exes = ["petrus", "petrus-mcp", "petrus-collab"]  # the test binary is also the oracle
    subprocess.run(["cabal", "build", "-v1", "-j", "--enable-tests", "petrus-viewer-server:exes", test], cwd=ROOT, check=True)
    for name, target in [(e, f"petrus-viewer-server:exe:{e}") for e in exes] + [("petrus-viewer-server-test", test)]:
        built = subprocess.run(["cabal", "list-bin", "-v0", "--enable-tests", target], cwd=ROOT, check=True,
                               capture_output=True, text=True).stdout.strip()
        shutil.copy2(built, bins / name)
    procs = []
    for i, group in enumerate(VIEWER_GROUPS):
        out = open(scratch / f"group-{i}.log", "w")
        procs.append((group, out, subprocess.Popen(["node", str(run_mjs), "--bin-dir", str(bins), *group],
                                                   cwd=ROOT, stdout=out, stderr=subprocess.STDOUT)))
    for group, out, proc in procs:
        proc.wait()
        out.close()
    for i, (group, out, proc) in enumerate(procs):
        print(f"\n==> upstream petrus-viewer suites {', '.join(group)}: exit {proc.returncode}", flush=True)
        print((scratch / f"group-{i}.log").read_text(), flush=True)
        status = status or proc.returncode
    shutil.rmtree(scratch, ignore_errors=True)
    return status


# check-all steps CI does not run: the benchmark measurements are opt-in
# (--bench); CI only smoke-runs them on a `full` dispatch (scripts/bench --smoke).
NOT_IN_CI = {"Benchmarks"}


def check_steps() -> int:
    """Every step of scripts/check-all is a step of CI (.github/workflows/
    ci.yml), by name: a step whose name starts with the check-all step's.
    A check added to check-all then fails CI until CI runs it too."""
    steps = re.findall(r'^\s*step "([^"]+)"', (ROOT / "scripts" / "check-all").read_text(), re.M)
    names = [n.strip().strip('"') for n in re.findall(r"^\s*-? *name: (.+)$", (ROOT / ".github" / "workflows" / "ci.yml").read_text(), re.M)]
    missing = [s for s in steps if s not in NOT_IN_CI and not any(n.startswith(s) for n in names)]
    for s in missing:
        print(f"ci-tests: scripts/check-all step {s!r} has no CI step of that name (.github/workflows/ci.yml)", file=sys.stderr)
    if not missing:
        print(f"ci-tests: CI runs all {len(steps) - len(NOT_IN_CI & set(steps))} scripts/check-all steps"
              f" (not: {', '.join(sorted(NOT_IN_CI))})")
    return 1 if missing else 0


def main(argv: List[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    command, rest = argv[0], argv[1:]
    commands = {
        "plan": lambda: plan(rest),
        "run-shard": lambda: run_shard(rest),
        "run-viewer": lambda: run_viewer(),
        "wrap": lambda: wrap(rest),
        "configure": lambda: configure(),
        "check-steps": lambda: check_steps(),
        "check-parts": lambda: check_parts(),
    }
    if command not in commands:
        print(f"unknown command {command}", file=sys.stderr)
        return 2
    return commands[command]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
