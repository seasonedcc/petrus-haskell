#!/usr/bin/env python3
"""Rerun every committed-corpus generator against the pinned references and diff.

    scripts/check-corpora              # every generator; fails on any stale file
    scripts/check-corpora NAME ...     # only the generators whose name contains NAME
    scripts/check-corpora --list       # the generators and the files each one writes
    scripts/check-corpora --update     # write the regenerated files over the committed ones
    scripts/check-corpora -jN          # N generators at a time (default 4)

Many ports are pinned by files the reference recorded once: differential
corpora, fixture databases, generated Haskell modules. A test that replays a
committed corpus keeps passing after the reference moves, so a stale corpus
hides a gap. This script reruns each generator (the commands their docstrings
and ledgers document) with the pinned interpreter from scripts/upstream-python
and compares the result with the committed bytes. scripts/check-all runs it,
and UPSTREAM.md's "Moving a pin" runs it with --update.

A generator whose script takes an output path writes into a temporary
directory. The few that can only write next to themselves (the Hamsterdan
generators and some fixture extractors) run in place: their committed files
are saved first and put back afterwards, so the working tree is unchanged
unless --update is given.

transcript_vectors.py replays the joined DST fixtures against PostgreSQL, so
when PETRUS_TEST_POSTGRES is unset the run happens under scripts/with-postgres.

Not rerun here, each for its own reason:

* petrus-engine-file's corpus.py: it resaves nets through the viewer's
  TypeScript under Node 22.18, which CI does not have; its LiveSpec reruns
  the reference on the committed corpus (the verdicts) and on fresh fuzz.
* petrus-cel's gen/gen-unicode-tables.py: it reads a downloaded Unicode/RE2
  data directory, not the pinned reference.
"""

from __future__ import annotations

import base64
import binascii
import concurrent.futures
import difflib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Dict, List, Optional, Tuple

ROOT = Path(__file__).resolve().parent.parent
UPSTREAM_PETRUS = ROOT / "upstream" / "petrus"


@dataclass
class Generator:
    name: str
    project: str
    script: str
    # Arguments after the script; "{out}" is the temporary output directory,
    # "{postgres}" the PostgreSQL URL.
    args: List[str]
    # Committed path (repository-relative) -> path under "{out}"; for an
    # in-place generator, the committed paths it rewrites (the values are
    # ignored).
    outputs: Dict[str, str]
    cwd: str = "upstream/petrus"
    in_place: bool = False
    needs_postgres: bool = False
    env: Dict[str, str] = field(default_factory=dict)
    # Committed path -> a function both sides pass through before the
    # comparison, for a file that embeds a run-specific value.
    normalize: Dict[str, Callable[[bytes], bytes]] = field(default_factory=dict)


def petrus(name: str, script: str, outputs: Dict[str, str], args: Optional[List[str]] = None, **kwargs) -> Generator:
    return Generator(name, "petrus", script, ["{out}"] if args is None else args, outputs, **kwargs)


def hamsterdan(name: str, script: str, outputs: List[str], **kwargs) -> Generator:
    return Generator(name, "hamsterdan", script, [], {path: path for path in outputs}, cwd=".", in_place=True, **kwargs)


