def sqlite_writer_free(content: bytes) -> bytes:
    """An SQLite database's header records, at offset 96, the version of the
    SQLite library that last wrote it: the pinned Python's bundled SQLite,
    which differs between platforms and builds (3.53.4 on macOS, 3.53.1 on
    CI's Linux) for the same pinned Python version. Leave those four bytes
    out of the comparison; every other byte must match."""
    if content.startswith(b"SQLite format 3\x00") and len(content) >= 100:
        return content[:96] + b"\x00\x00\x00\x00" + content[100:]
    return content


# The same OSError on each platform: EOVERFLOW's number and message differ
# between macOS (where the committed corpora are recorded) and Linux (CI).
PLATFORM_ERRORS = [
    (b"[Errno 84] Value too large to be stored in data type", b"[Errno EOVERFLOW]"),
    (b"[Errno 75] Value too large for defined data type", b"[Errno EOVERFLOW]"),
]


def platform_errors_free(content: bytes) -> bytes:
    """Replace each platform's text for the same OSError by one marker."""
    for platform_text, marker in PLATFORM_ERRORS:
        content = content.replace(platform_text, marker)
    return content


def scratch_root_free(content: bytes) -> bytes:
    """pi_corpus.json builds its live invocations under a fresh temporary
    directory, whose (resolved) path lands in the recorded working
    directories, private roots and the base64 wire bytes of each start frame.
    Replace that directory, everywhere it occurs, by a fixed marker."""
    corpus = json.loads(content)
    starts = corpus.get("frames", {}).get("starts", [])
    if not starts:
        return content
    scratch = starts[0]["cwd"].split("/frames/")[0]
    marker = "<scratch>"

    def scrub(value):
        if isinstance(value, dict):
            return {key: scrub(item) for key, item in value.items()}
        if isinstance(value, list):
            return [scrub(item) for item in value]
        if isinstance(value, str):
            if scratch in value:
                return value.replace(scratch, marker)
            try:
                decoded = base64.b64decode(value, validate=True)
            except (binascii.Error, ValueError):
                return value
            if scratch.encode() in decoded:
                return "base64:" + decoded.replace(scratch.encode(), marker.encode()).decode("utf-8", "backslashreplace")
        return value

    return (json.dumps(scrub(corpus), indent=1, ensure_ascii=True, allow_nan=True) + "\n").encode()


def dst(name: str, output: str, *, postgres: bool = False) -> Generator:
    args = (["{postgres}"] if postgres else []) + ["{out}/" + Path(output).name]
    return Generator(
        f"petrus-dst/{name}",
        "petrus",
        f"{DST}/scripts/{name}.py",
        args,
        {f"{DST}/{output}": Path(output).name},
        needs_postgres=postgres,
    )


