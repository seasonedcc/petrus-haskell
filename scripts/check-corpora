def environment() -> Dict[str, str]:
    env = dict(os.environ)
    extra = [str(Path.home() / ".ghcup" / "bin"), str(Path.home() / ".local" / "bin")]
    env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


ENV = environment()


def interpreter(project: str) -> str:
    """The pinned Python of an upstream project, or Node for the generators
    that record Node's own behaviour (project "node"; Node 22, as in CI)."""
    if project == "node":
        node = shutil.which("node", path=ENV["PATH"])
        if node is None:
            raise SystemExit("check-corpora: node is not on PATH (the viewer's Node-recorded corpora need Node 22)")
        version = subprocess.run([node, "--version"], env=ENV, check=True, stdout=subprocess.PIPE, text=True).stdout.strip()
        if not version.startswith("v22."):
            raise SystemExit(f"check-corpora: the viewer's Node-recorded corpora need Node 22, not {version}")
        return node
    return subprocess.run(
        [str(ROOT / "scripts" / "upstream-python"), project], cwd=ROOT, env=ENV, check=True, stdout=subprocess.PIPE, text=True
    ).stdout.strip()


@dataclass
class Result:
    generator: Generator
    seconds: float
    stale: List[Tuple[str, str]]  # (committed path, description)
    failure: Optional[str] = None


def describe_difference(path: str, old: bytes, new: bytes) -> str:
    if old == new:
        return ""
    try:
        old_lines = old.decode("utf-8").splitlines()
        new_lines = new.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return f"{path}: binary content differs ({len(old)} committed bytes, {len(new)} regenerated)"
    diff = list(difflib.unified_diff(old_lines, new_lines, f"committed/{path}", f"regenerated/{path}", n=0, lineterm=""))
    shown = [line if len(line) <= 200 else line[:200] + "…" for line in diff[:12]]
    more = f"\n    … {len(diff) - 12} more diff lines" if len(diff) > 12 else ""
    return "\n".join("    " + line for line in shown) + more


def run_generator(generator: Generator, python: str, postgres: Optional[str], update: bool) -> Result:
    started = time.monotonic()
    env = dict(ENV)
    env["PYTHONPATH"] = str(UPSTREAM_PETRUS) if generator.project == "petrus" else ""
    env.update(generator.env)
    with tempfile.TemporaryDirectory(prefix="check-corpora-") as scratch:
        out = Path(scratch)
        saved: Dict[str, Optional[bytes]] = {}
        if generator.in_place:
            for path in generator.outputs:
                target = ROOT / path
                saved[path] = target.read_bytes() if target.exists() else None
        args = [arg.replace("{out}", str(out)).replace("{postgres}", postgres or "") for arg in generator.args]
        command = [python, *([] if generator.project == "node" else ["-B"]), str(ROOT / generator.script), *args]
        try:
            completed = subprocess.run(
                command, cwd=ROOT / generator.cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
            )
            if completed.returncode != 0:
                tail = "\n".join(completed.stdout.splitlines()[-15:])
                return Result(generator, time.monotonic() - started, [], f"exit {completed.returncode}:\n{tail}")
            stale = []
            for path, produced in generator.outputs.items():
                committed = saved.get(path) if generator.in_place else ((ROOT / path).read_bytes() if (ROOT / path).exists() else None)
                fresh_path = ROOT / path if generator.in_place else out / produced
                if not fresh_path.exists():
                    return Result(generator, time.monotonic() - started, [], f"did not write {fresh_path}")
                fresh = fresh_path.read_bytes()
                normalize = generator.normalize.get(path, lambda content: content)

                def same(content: bytes, normalize=normalize) -> bytes:
                    return normalize(sqlite_writer_free(content))
                if committed is None or same(committed) != same(fresh):
                    stale.append((path, describe_difference(path, same(committed or b"{}"), same(fresh))))
                    if update and not generator.in_place:
                        (ROOT / path).parent.mkdir(parents=True, exist_ok=True)
                        shutil.copyfile(fresh_path, ROOT / path)
            return Result(generator, time.monotonic() - started, stale)
        finally:
            if generator.in_place and not update:
                for path, content in saved.items():
                    target = ROOT / path
                    if content is None:
                        target.unlink(missing_ok=True)
                    elif not target.exists() or target.read_bytes() != content:
                        target.write_bytes(content)


def main(argv: List[str]) -> int:
    jobs = 4
    flags = []
    names = []
    for arg in argv:
        if re.fullmatch(r"-j\d+", arg):
            jobs = max(1, int(arg[2:]))
        elif arg.startswith("-"):
            flags.append(arg)
        else:
            names.append(arg)
    if any(flag not in {"--list", "--update", "-h", "--help"} for flag in flags) or "-h" in flags or "--help" in flags:
        print(__doc__, file=sys.stderr)
        return 0 if ("-h" in flags or "--help" in flags) else 2
    selected = [g for g in GENERATORS if not names or any(name in g.name for name in names)]
    if not selected:
        print(f"no generator matches {' '.join(names)}", file=sys.stderr)
        return 2
    if "--list" in flags:
        for generator in selected:
            mode = "in place" if generator.in_place else "temporary directory"
            print(f"{generator.name} ({generator.project}, {mode}): {generator.script}")
            for path in generator.outputs:
                print(f"    {path}")
        return 0
    postgres = os.environ.get("PETRUS_TEST_POSTGRES")
    if not postgres and any(g.needs_postgres for g in selected):
        return subprocess.call([str(ROOT / "scripts" / "with-postgres"), sys.executable, __file__, *argv], env=ENV)
    pythons = {project: interpreter(project) for project in sorted({g.project for g in selected})}
    update = "--update" in flags
    started = time.monotonic()
    results: List[Result] = []
    # In-place generators share the pool: no two generators write the same
    # file, and none reads another's output.
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = [pool.submit(run_generator, g, pythons[g.project], postgres, update) for g in selected]
        for future in concurrent.futures.as_completed(futures):
            results.append(future.result())
            report(results[-1])
    failed = [r for r in results if r.failure]
    stale = [r for r in results if r.stale]
    elapsed = time.monotonic() - started
    files = sum(len(r.generator.outputs) for r in results)
    if failed or (stale and not update):
        print(f"\ncheck-corpora: {len(failed)} generators failed, {len(stale)} have stale files ({elapsed:.0f}s)", file=sys.stderr)
        if stale and not update:
            print("Regenerate with: scripts/check-corpora --update " + " ".join(f"'{r.generator.name}'" for r in stale), file=sys.stderr)
        return 1
    verb = "updated" if update and stale else "current"
    print(f"\ncheck-corpora: {len(results)} generators, {files} files {verb} ({elapsed:.0f}s)")
    return 0


def report(result: Result) -> None:
    name = result.generator.name
    if result.failure:
        print(f"FAIL  {name} ({result.seconds:.1f}s): {result.failure}", flush=True)
    elif result.stale:
        print(f"STALE {name} ({result.seconds:.1f}s)", flush=True)
        for path, description in result.stale:
            print(f"  {path}\n{description}", flush=True)
    else:
        print(f"ok    {name} ({result.seconds:.1f}s)", flush=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
